---
import '../styles/global.css';
import { social } from '../data/leagueData.js';
const { title = "Burger Town Leagues", description = "Call of Duty: Black Ops Cold War competitive league. Stats, standings, and history." } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/images/burger-icon.png" />
</head>
<body>
  <nav class="site-nav">
    <div class="wrap nav-wrap">
      <a class="brand" href="/">
        <img src="/images/burger-icon.png" alt="" />
        Burger Town
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <ul class="nav-links">
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
        <li><a href="/current-season" aria-current={currentPath.startsWith('/current-season') ? 'page' : undefined}>Current Season</a></li>
        <li><a href="/history" aria-current={currentPath.startsWith('/history') || currentPath.startsWith('/season') ? 'page' : undefined}>History</a></li>
        <li><a href="/players" aria-current={currentPath.startsWith('/players') ? 'page' : undefined}>Players</a></li>
        <li><a href="/hall-of-fame" aria-current={currentPath === '/hall-of-fame' ? 'page' : undefined}>Hall of Fame</a></li>
        <li class="nav-cta-mobile"><a href={social.discord} target="_blank" rel="noopener">Discord</a></li>
      </ul>
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>
      <div class="nav-cta">
        <a class="btn btn-ghost" href={social.discord} target="_blank" rel="noopener">Discord</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <span>© {new Date().getFullYear()} Burger Town Leagues · <a href={`mailto:${social.email}`}>{social.email}</a></span>
      <ul class="footer-links">
        <li><a href={social.youtube} target="_blank" rel="noopener">YouTube</a></li>
        <li><a href={social.twitter} target="_blank" rel="noopener">Twitter/X</a></li>
        <li><a href={social.discord} target="_blank" rel="noopener">Discord</a></li>
      </ul>
    </div>
  </footer>
  <script src="/scripts/sortable-table.js" is:inline></script>
</body>
</html>
