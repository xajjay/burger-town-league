---
import Base from '../../layouts/Base.astro';
import { careerStats, seasonStats } from '../../data/leagueData.js';

export function getStaticPaths() {
  return careerStats.map(p => ({ params: { name: p.player } }));
}

const { name } = Astro.params;
const player = careerStats.find(p => p.player === name);

const seasonRows = player
  ? player.seasons.map(sid => {
      const row = (seasonStats[sid] || []).find(r => r.player === name);
      return row ? { season: sid, ...row } : null;
    }).filter(Boolean)
  : [];
---
<Base title={player ? `${player.player} — Burger Town Leagues` : 'Player not found'}>
  <section>
    <div class="wrap">
      {player ? (
        <>
          <div class="pixel-card" style="max-width: 480px; margin-bottom: 40px;">
            <span class="eyebrow">Service Record</span>
            <h1 class="script-heading" style="font-size: 2.4rem;">{player.player}</h1>
            <p style="font-family: var(--font-mono); font-size: 1.4rem; color: var(--gold); margin: 8px 0;">
              {player.kd.toFixed(2)} <span style="font-size: 0.7rem; color: var(--paper-dim); font-family: var(--font-body);">CAREER K/D</span>
            </p>
            <p style="color: var(--paper-dim); margin: 4px 0;">{player.kills} kills · {player.deaths} deaths · {player.seasons.length} seasons played</p>
            <div style="margin-top: 12px;">
              {player.accolades.split(';').map(a => <span class="badge badge-red">{a.trim()}</span>)}
            </div>
          </div>

          <h2 class="section-title">Season-by-Season</h2>
          <div class="table-scroll">
            <table class="stat-table">
              <thead><tr><th>Season</th><th>Team</th><th>Kills</th><th>Deaths</th><th>K/D</th><th>Maps</th></tr></thead>
              <tbody>
                {seasonRows.map(r => (
                  <tr>
                    <td><a href={`/season/${r.season}`}>Season {r.season}</a></td>
                    <td>{r.team}</td>
                    <td>{r.kills}</td>
                    <td>{r.deaths}</td>
                    <td>{r.kd.toFixed(2)}</td>
                    <td>{r.maps}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p>Player not found.</p>
      )}
    </div>
  </section>
</Base>
