---
import Base from '../../layouts/Base.astro';
import { careerStats, perPlayerSeasonHonors, seasonStats } from '../../data/leagueData.js';

export function getStaticPaths() {
  return careerStats.map(p => ({ params: { name: p.player } }));
}

const { name } = Astro.params;
const player = careerStats.find(p => p.player === name);

const honorsBySeason = player ? (perPlayerSeasonHonors[player.player] || {}) : {};

const seasonRows = player
  ? player.seasons.map(sid => {
      const kd = player.seasonKD[sid];
      const row = (seasonStats[sid] || []).find(r => r.player === player.player);
      return {
        season: sid,
        kd: kd,
        team: row?.team || '',
        kills: row?.kills,
        deaths: row?.deaths,
        maps: row?.maps,
        overall: row?.overall,
        honors: honorsBySeason[sid] || [],
      };
    })
  : [];

// Build tag chips: one per honor type, tagged with which season(s)
const tagGroups = {};
for (const row of seasonRows) {
  for (const h of row.honors) {
    (tagGroups[h] ||= []).push(row.season);
  }
}
const tags = Object.entries(tagGroups).map(([label, seasonsList]) => ({
  label,
  seasons: seasonsList,
}));
---
<Base title={player ? `${player.player} | Burger Town Leagues` : 'Player not found'}>
  <section>
    <div class="wrap">
      {player ? (
        <>
          <div class="pixel-card" style="max-width: 560px; margin-bottom: 40px; display: flex; gap: 24px; align-items: flex-start;">
            <div style="flex: 1;">
              <span class="eyebrow">Service Record</span>
              <h1 class="script-heading" style="font-size: 2.4rem;">{player.player}</h1>
              <p style="font-family: var(--font-mono); font-size: 1.4rem; color: var(--gold); margin: 8px 0;">
                {player.kd.toFixed(2)} <span style="font-size: 0.7rem; color: var(--paper-dim); font-family: var(--font-body);">CAREER K/D</span>
              </p>
              <p style="color: var(--paper-dim); margin: 4px 0;">{player.kills.toLocaleString()} kills · {player.deaths.toLocaleString()} deaths · {player.seasons.length} season{player.seasons.length !== 1 ? 's' : ''} played</p>
              {tags.length > 0 && (
                <div style="margin-top: 12px;">
                  {tags.map(t => (
                    <span class="badge badge-red" title={`Season ${t.seasons.join(', ')}`}>{t.label} ({t.seasons.map(s => `S${s}`).join(', ')})</span>
                  ))}
                </div>
              )}
            </div>
            {player.overall != null && (
              <div class="ovr-badge">
                <span class="ovr-number">{player.overall}</span>
                <span class="ovr-label">OVR</span>
              </div>
            )}
          </div>

          <h2 class="section-title">Season-by-Season</h2>
          <div class="table-scroll">
            <table class="stat-table">
              <thead><tr><th>Season</th><th>Team</th><th>Kills</th><th>Deaths</th><th>K/D</th><th>Maps</th><th>OVR</th><th>Honors</th></tr></thead>
              <tbody>
                {seasonRows.map(r => (
                  <tr>
                    <td><a href={`/season/${r.season}`}>Season {r.season}</a></td>
                    <td>{r.team}</td>
                    <td>{r.kills ?? 'N/A'}</td>
                    <td>{r.deaths ?? 'N/A'}</td>
                    <td>{r.kd?.toFixed(2) ?? 'N/A'}</td>
                    <td>{r.maps ?? 'N/A'}</td>
                    <td style="color: var(--gold); font-weight: 700;">{r.overall ?? 'N/A'}</td>
                    <td>{r.honors.map(h => <span class="badge badge-gold">{h}</span>)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p>Player not found. <a href="/players">Browse all players</a>.</p>
      )}
    </div>
  </section>
</Base>
