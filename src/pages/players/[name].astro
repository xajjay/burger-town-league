---
import Base from '../../layouts/Base.astro';
import { careerStats, perPlayerSeasonHonors, seasonStats, getPlayerPhoto, getHofEntry, getAllStarCount, getSpecialBadges, tournamentWinners } from '../../data/leagueData.js';

export function getStaticPaths() {
  return careerStats.map(p => ({ params: { name: p.player } }));
}

const { name } = Astro.params;
const player = careerStats.find(p => p.player === name);

const honorsBySeason = player ? (perPlayerSeasonHonors[player.player] || {}) : {};

const seasonRows = player
  ? player.seasons.map(sid => {
      const kd = player.seasonKD[sid];
      const row = (seasonStats[sid] || []).find(r => r.player === player.player);
      return {
        season: sid,
        kd: kd,
        team: row?.team || '',
        kills: row?.kills,
        deaths: row?.deaths,
        maps: row?.maps,
        overall: row?.overall,
        honors: honorsBySeason[sid] || [],
      };
    })
  : [];

// Build tag chips: one per honor type, tagged with which season(s)
// (Super Burger is excluded here since it's already shown as a special badge above)
const tagGroups = {};
for (const row of seasonRows) {
  for (const h of row.honors) {
    if (h === 'Super Burger') continue;
    (tagGroups[h] ||= []).push(row.season);
  }
}
const tags = Object.entries(tagGroups).map(([label, seasonsList]) => ({
  label,
  seasons: seasonsList,
}));

// Tournament wins render alongside season honor tags (e.g. next to Season Champion)
if (player) {
  for (const t of tournamentWinners) {
    if (t.players.some(p => p.toLowerCase() === player.player.toLowerCase())) {
      tags.push({ label: `Tournament Winner — ${t.name}`, seasons: null });
    }
  }
}

const overall = player?.overall;
let tier = 'basic';
if (overall >= 95) tier = 'legend';
else if (overall >= 90) tier = 'elite';

const photo = player ? getPlayerPhoto(player.player) : null;
const hofEntry = player ? getHofEntry(player.player) : null;
const allStarCount = player ? getAllStarCount(player.player) : 0;
const specialBadges = player ? getSpecialBadges(player.player) : [];
---
<Base title={player ? `${player.player} | Burger Town Leagues` : 'Player not found'}>
  <section>
    <div class="wrap">
      {player ? (
        <>
          <span class="eyebrow">Player Card</span>
          <div class={`player-card tier-${tier}`}>
            {allStarCount > 0 && (
              <div class="player-card-star-stripe" title={`${allStarCount} All-Star selection${allStarCount !== 1 ? 's' : ''}`}>
                {'★'.repeat(Math.min(allStarCount, 6))}
              </div>
            )}
            <div class="player-card-top">
              {overall != null && (
                <div class="player-card-ovr">
                  <span class="player-card-ovr-number">{overall}</span>
                  <span class="player-card-ovr-label">OVR</span>
                </div>
              )}
              {photo ? (
                <img class="player-card-photo" src={photo} alt={player.player} />
              ) : (
                <div class="player-card-name-only">
                  <span class="script-heading">{player.player}</span>
                </div>
              )}
            </div>
            {photo && <h1 class="script-heading player-card-name">{player.player}</h1>}
            <div class="player-card-stats">
              <div class="player-card-stat">
                <span class="player-card-stat-value">{player.kd.toFixed(2)}</span>
                <span class="player-card-stat-label">Career K/D</span>
              </div>
              <div class="player-card-stat">
                <span class="player-card-stat-value">{player.kills.toLocaleString()}</span>
                <span class="player-card-stat-label">Kills</span>
              </div>
              <div class="player-card-stat">
                <span class="player-card-stat-value">{player.maps.toLocaleString()}</span>
                <span class="player-card-stat-label">Maps Played</span>
              </div>
              <div class="player-card-stat">
                <span class="player-card-stat-value">{player.seasons.length}</span>
                <span class="player-card-stat-label">Season{player.seasons.length !== 1 ? 's' : ''}</span>
              </div>
            </div>
            {specialBadges.filter(b => b.type !== 'tournament').length > 0 && (
              <div class="special-badges">
                {specialBadges.filter(b => b.type !== 'tournament').map(b => (
                  <span
                    class={`special-badge special-badge-${b.type}`}
                    title={
                      b.type === 'goat' ? 'Hall of Fame Rank #1 — Greatest Of All Time' :
                      b.type === 'hof' ? 'Hall of Fame member' :
                      'Awarded to the player with the lowest Overall rating that season'
                    }
                  >
                    {b.type === 'goat' && '🐐'}
                    {b.type === 'superburger' && <img src="/images/badges/super-burger.jpg" alt="" />}
                    {b.type === 'hof' && hofEntry ? `${b.label} #${hofEntry.rank}` : b.label}
                  </span>
                ))}
              </div>
            )}
            {tags.length > 0 && (
              <div class="player-card-tags">
                {tags.map(t => (
                  <span class="badge badge-red" title={t.seasons ? `Season ${t.seasons.join(', ')}` : t.label}>
                    {t.seasons ? `${t.label} (${t.seasons.map(s => `S${s}`).join(', ')})` : t.label}
                  </span>
                ))}
              </div>
            )}
          </div>

          <h2 class="section-title">Season-by-Season</h2>
          <div class="table-scroll">
            <table class="stat-table">
              <thead><tr><th>Season</th><th>Team</th><th>Kills</th><th>Deaths</th><th>K/D</th><th>Maps</th><th>OVR</th><th>Honors</th></tr></thead>
              <tbody>
                {seasonRows.map(r => (
                  <tr>
                    <td><a href={`/season/${r.season}`}>Season {r.season}</a></td>
                    <td>{r.team}</td>
                    <td>{r.kills ?? 'N/A'}</td>
                    <td>{r.deaths ?? 'N/A'}</td>
                    <td>{r.kd?.toFixed(2) ?? 'N/A'}</td>
                    <td>{r.maps ?? 'N/A'}</td>
                    <td style="color: var(--gold); font-weight: 700;">{r.overall ?? 'N/A'}</td>
                    <td>{r.honors.map(h => <span class="badge badge-gold">{h}</span>)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p>Player not found. <a href="/players">Browse all players</a>.</p>
      )}
    </div>
  </section>
</Base>
