---
import Base from '../../layouts/Base.astro';
import { seasons, careerStats, isHofPlayer, hasSuperBurger, allTimeRecords } from '../../data/leagueData.js';

const currentPath = Astro.url.pathname;
const historyTabs = [
  { href: "/history", label: "Draft League History" },
  ...seasons.map(s => ({ href: `/season/${s.id}`, label: `${s.name} (${s.year})` })),
  { href: "/history/all-seasons", label: "All Seasons" },
];

const sorted = [...careerStats].sort((a, b) => (b.overall ?? -1) - (a.overall ?? -1));
---
<Base title="All Seasons | Burger Town Leagues">
  <section style="padding-bottom: 0;">
    <div class="wrap">
      <div class="season-pills">
        {historyTabs.map(t => (
          <a class={`season-pill ${currentPath === t.href ? 'active' : ''}`} href={t.href}>{t.label}</a>
        ))}
      </div>
      <span class="eyebrow">Career Totals</span>
      <h1 class="script-heading">All Seasons Combined</h1>
      <p style="color: var(--paper-dim); max-width: 60ch;">
        Every player's combined stats across every season recorded, spanning both prior leagues.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p style="color: var(--paper-dim); font-size: 0.85rem; margin-bottom: 12px;">Click any column header to sort. Sorted by Overall by default.</p>
      <div class="table-scroll">
        <table class="stat-table sortable-table">
          <thead>
            <tr>
              <th data-sort="text">Player</th>
              <th data-sort="num">K/D</th>
              <th data-sort="num" data-dir="desc" class="sorted-desc">Overall</th>
              <th data-sort="num">Seasons Played</th>
              <th>Accolades</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((p) => (
              <tr>
                <td data-value={p.player}><a href={`/players/${encodeURIComponent(p.player)}`} class={`${isHofPlayer(p.player) ? 'hof-name' : ''} ${hasSuperBurger(p.player) ? 'superburger-name' : ''}`}>{p.player}</a></td>
                <td data-value={p.kd}>{p.kd.toFixed(2)}</td>
                <td data-value={p.overall ?? ''} style="color: var(--gold); font-weight: 700;">{p.overall ?? 'N/A'}</td>
                <td data-value={p.seasons.length}>{p.seasons.map(s => `S${s}`).join(', ')}</td>
                <td style="white-space: normal; min-width: 260px; font-family: var(--font-body); font-size: 0.8rem; color: var(--paper-dim);">{p.accolades}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {allTimeRecords.length > 0 && (
    <section>
      <div class="wrap">
        <h2 class="section-title">All-Time Records</h2>
        <p style="color: var(--paper-dim); font-size: 0.85rem; margin-bottom: 12px;">The best (or lowest, for "Low" categories) value ever recorded per category, across Seasons 1–5.</p>
        <div class="table-scroll">
          <table class="stat-table">
            <thead><tr><th>Record</th><th>Hardpoint</th><th>Search &amp; Destroy</th><th>Control</th><th>Series</th></tr></thead>
            <tbody>
              {allTimeRecords.map(r => (
                <tr>
                  <td>{r.category}</td>
                  {['HP', 'SnD', 'Control', 'Series'].map(mode => (
                    r.modes[mode] ? (
                      <td>
                        {r.modes[mode].holder && <a href={`/players/${encodeURIComponent(r.modes[mode].holder)}`}>{r.modes[mode].holder}</a>}
                        {r.modes[mode].value !== null && r.modes[mode].value !== undefined && <span style="color: var(--gold); margin-left: 4px;">({r.modes[mode].value})</span>}
                        <span style="color: var(--paper-dim); font-size: 0.75rem; margin-left: 4px;">S{r.modes[mode].season}</span>
                      </td>
                    ) : <td>N/A</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
</Base>
