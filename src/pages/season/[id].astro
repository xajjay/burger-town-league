---
import Base from '../../layouts/Base.astro';
import { seasons, seasonStats, standings, seriesList, seasonRecords, isHofPlayer, hasSuperBurger } from '../../data/leagueData.js';

export function getStaticPaths() {
  return seasons.map(s => ({ params: { id: String(s.id) } }));
}

const { id } = Astro.params;
const seasonId = Number(id);
const season = seasons.find(s => s.id === seasonId);
const stats = [...(seasonStats[seasonId] || [])].sort((a, b) => (b.overall ?? -1) - (a.overall ?? -1));
const seasonStandings = standings[seasonId] || [];
const seasonSeries = seriesList.filter(s => s.season === seasonId);
const records = seasonRecords[String(seasonId)] || [];

const historyTabs = [
  { href: "/history", label: "Draft League History" },
  ...seasons.map(s => ({ href: `/season/${s.id}`, label: `${s.name} (${s.year})` })),
  { href: "/history/all-seasons", label: "All Seasons" },
];
const currentPath = Astro.url.pathname;
---
<Base title={`${season.name} | Burger Town Leagues`}>
  <section style="padding-bottom: 0;">
    <div class="wrap">
      <div class="season-pills">
        {historyTabs.map(t => (
          <a class={`season-pill ${currentPath === t.href ? 'active' : ''}`} href={t.href}>{t.label}</a>
        ))}
      </div>
      <span class="eyebrow">{season.status} · {season.league}</span>
      <h1 class="script-heading">{season.name} ({season.year})</h1>
      <p style="color: var(--paper-dim); max-width: 60ch;">
        Champion: <strong style="color: var(--gold);">{season.champion}</strong>
        {season.mvp !== 'TBD' && <> · MVP: <strong style="color: var(--gold);">{season.mvp}</strong></>}
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-title">Player Stats</h2>
      <p style="color: var(--paper-dim); font-size: 0.85rem; margin-bottom: 12px;">Click any column header to sort. Sorted by Overall by default.</p>
      <div class="table-scroll">
        <table class="stat-table sortable-table">
          <thead>
            <tr>
              <th data-sort="text">Player</th>
              <th data-sort="text">Team</th>
              <th data-sort="num">K/D</th>
              <th data-sort="num">Respawn KD</th>
              <th data-sort="num">SnD KD</th>
              <th data-sort="num">Interactions</th>
              <th data-sort="num">Maps</th>
              <th data-sort="num" data-dir="desc" class="sorted-desc">OVR</th>
              <th>Honors</th>
            </tr>
          </thead>
          <tbody>
            {stats.map((p) => (
              <tr>
                <td data-value={p.player}><a href={`/players/${encodeURIComponent(p.player)}`} class={`${isHofPlayer(p.player) ? 'hof-name' : ''} ${hasSuperBurger(p.player) ? 'superburger-name' : ''}`}>{p.player}</a></td>
                <td>{p.team}</td>
                <td data-value={p.kd}>{p.kd.toFixed(2)}</td>
                <td data-value={p.respawnKd ?? ''}>{p.respawnKd != null ? p.respawnKd.toFixed(2) : 'N/A'}</td>
                <td data-value={p.sndKd ?? ''}>{p.sndKd != null ? p.sndKd.toFixed(2) : 'N/A'}</td>
                <td data-value={p.interactionsPerMap ?? ''}>{p.interactionsPerMap != null ? p.interactionsPerMap.toFixed(1) : 'N/A'}</td>
                <td data-value={p.maps}>{p.maps}</td>
                <td data-value={p.overall ?? ''} style="color: var(--gold); font-weight: 700;">{p.overall ?? 'N/A'}</td>
                <td>{p.honors.map(h => <span class="badge badge-gold">{h}</span>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {seasonStandings.length > 0 && (
    <section>
      <div class="wrap">
        <h2 class="section-title">Final Standings</h2>
        <div class="table-scroll">
          <table class="stat-table">
            <thead><tr><th>#</th><th>Team</th><th>Record</th><th>Win %</th><th>Map Record</th><th>Manager</th></tr></thead>
            <tbody>
              {seasonStandings.map(s => (
                <tr>
                  <td class={s.rank === 1 ? 'rank-1' : ''}>{s.rank}</td>
                  <td>
                    {s.team}
                    {s.champion && <span class="badge badge-gold">Champion</span>}
                    {s.runnerUp && <span class="badge badge-red">Runner-Up</span>}
                  </td>
                  <td>{s.record || 'N/A'}</td>
                  <td>{s.winPct || 'N/A'}</td>
                  <td>{s.mapRecord || 'N/A'}</td>
                  <td>{s.manager || 'N/A'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 style="font-family: var(--font-body); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.04em; color: var(--paper-dim); margin: 28px 0 12px;">Team Rosters</h3>
        {seasonStandings.filter(s => s.roster && s.roster.length > 0).map(s => (
          <details class="roster-details">
            <summary>{s.team} <span style="color: var(--paper-dim); font-weight: 400;">({s.roster.length} players)</span></summary>
            <div class="table-scroll">
              <table class="stat-table">
                <thead><tr><th>Player</th><th>K/D</th><th>OVR</th></tr></thead>
                <tbody>
                  {s.roster.map(r => (
                    <tr>
                      <td><a href={`/players/${encodeURIComponent(r.player)}`} class={`${isHofPlayer(r.player) ? 'hof-name' : ''} ${hasSuperBurger(r.player) ? 'superburger-name' : ''}`}>{r.player}</a></td>
                      <td>{r.kd != null ? r.kd.toFixed(2) : 'N/A'}</td>
                      <td style="color: var(--gold); font-weight: 700;">{r.overall ?? 'N/A'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}
      </div>
    </section>
  )}

  {records.length > 0 && (
    <section>
      <div class="wrap">
        <h2 class="section-title">Season Records</h2>
        <div class="table-scroll">
          <table class="stat-table">
            <thead><tr><th>Record</th><th>Hardpoint</th><th>Search &amp; Destroy</th><th>Control</th><th>Series</th></tr></thead>
            <tbody>
              {records.map(r => (
                <tr>
                  <td>{r.category}</td>
                  {['HP', 'SnD', 'Control', 'Series'].map(mode => (
                    r.modes[mode] ? (
                      <td>
                        {r.modes[mode].holder && <a href={`/players/${encodeURIComponent(r.modes[mode].holder)}`}>{r.modes[mode].holder}</a>}
                        {r.modes[mode].value !== null && r.modes[mode].value !== undefined && <span style="color: var(--gold); margin-left: 4px;">({r.modes[mode].value})</span>}
                      </td>
                    ) : <td>N/A</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {seasonSeries.length > 0 && (
    <section>
      <div class="wrap">
        <h2 class="section-title">Series Results</h2>
        <p style="color: var(--paper-dim); font-size: 0.9rem; margin-bottom: 16px;">Click a series to see the full per-player, per-map breakdown.</p>
        <div class="table-scroll">
          <table class="stat-table">
            <thead><tr><th>Series</th><th>Teams</th></tr></thead>
            <tbody>
              {seasonSeries.map(s => (
                <tr>
                  <td><a href={`/season/${seasonId}/series/${s.slug}`}>{s.name}</a> {s.isPlayoff && <span class="badge badge-red">Playoffs</span>}</td>
                  <td>{s.teams.map(t => t.team).join(' vs ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
</Base>
