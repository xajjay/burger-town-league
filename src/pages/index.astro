---
import Base from '../layouts/Base.astro';
import { hallOfFame, careerStats, social, foundedYear, homeDescription, signupFormUrl, upcomingSeasonLabel, upcomingSeasonYear } from '../data/leagueData.js';

const top5 = hallOfFame.slice(0, 5).map(p => ({
  ...p,
  overall: careerStats.find(c => c.player === p.player)?.overall ?? null,
}));
---
<Base title="Burger Town Leagues | Cold War Draft League">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Est. {foundedYear}</span>
        <h1 class="script-heading">Burger Town Leagues</h1>
        <p>{homeDescription}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/current-season">View Current Season</a>
          <a class="btn btn-ghost" href={social.youtube} target="_blank" rel="noopener">Watch on YouTube</a>
        </div>
      </div>
      <div class="hero-art">
        <img src="/images/logo-full.png" alt="Burger Town Leagues logo" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="pixel-card" style="text-align: center; padding: 40px 24px;">
        <span class="eyebrow">Sign Ups Open</span>
        <h2 class="script-heading" style="font-size: 2rem; margin-bottom: 12px;">Join {upcomingSeasonLabel} ({upcomingSeasonYear})</h2>
        <p style="color: var(--paper-dim); max-width: 50ch; margin: 0 auto 20px;">
          Burger Town's first official season is forming now. Sign up to be drafted onto a team and join the next chapter of the Cold War Draft League.
        </p>
        <a class="btn btn-primary" href={signupFormUrl} target="_blank" rel="noopener">Sign Up Now</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-title">Hall of Fame: Top 5</h2>
      <div class="table-scroll">
        <table class="stat-table">
          <thead><tr><th>#</th><th>Player</th><th>Career K/D</th><th>Lifetime OVR</th><th>Legacy Score</th></tr></thead>
          <tbody>
            {top5.map(p => (
              <tr>
                <td class={p.rank === 1 ? 'rank-1' : ''}>{p.rank}</td>
                <td><a href={`/players/${encodeURIComponent(p.player)}`}>{p.player}</a></td>
                <td>{p.kd.toFixed(2)}</td>
                <td style="color: var(--gold); font-weight: 700;">{p.overall ?? 'N/A'}</td>
                <td style="color: var(--gold); font-weight: 700;">{p.legacyScore.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 16px;"><a class="btn btn-ghost" href="/hall-of-fame">View Full Hall of Fame</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-title">Stay in the loop</h2>
      <div class="grid grid-4">
        <div class="pixel-card">
          <span class="eyebrow">YouTube</span>
          <p>Match VODs and season recaps, posted after every series.</p>
          <a class="btn btn-primary" href={social.youtube} target="_blank" rel="noopener">Subscribe</a>
        </div>
        <div class="pixel-card">
          <span class="eyebrow">Twitter / X</span>
          <p>Live updates, standings, and announcements. Follow @burgrtown.</p>
          <a class="btn btn-primary" href={social.twitter} target="_blank" rel="noopener">Follow</a>
        </div>
        <div class="pixel-card">
          <span class="eyebrow">Discord</span>
          <p>Sign up for a draft, talk trash, and get match reminders.</p>
          <a class="btn btn-primary" href={social.discord} target="_blank" rel="noopener">Join Server</a>
        </div>
        <div class="pixel-card">
          <span class="eyebrow">Hall of Fame</span>
          <p>Every champion, MVP, and All-Star since Season 1.</p>
          <a class="btn btn-ghost" href="/hall-of-fame">View History</a>
        </div>
      </div>
    </div>
  </section>
</Base>
