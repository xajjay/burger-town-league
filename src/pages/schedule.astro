---
import Base from '../layouts/Base.astro';
import { matches } from '../data/leagueData.js';

const sorted = [...matches].sort((a, b) => new Date(b.date) - new Date(a.date));
---
<Base title="Schedule — Burger Town Leagues">
  <section>
    <div class="wrap">
      <span class="eyebrow">Match Log</span>
      <h1 class="script-heading" style="margin-bottom: 32px;">Schedule &amp; Results</h1>
      <div class="table-scroll">
        <table class="stat-table">
          <thead><tr><th>Week</th><th>Matchup</th><th>Score</th><th>Date</th></tr></thead>
          <tbody>
            {sorted.map(m => (
              <tr>
                <td>{m.week}</td>
                <td>{m.teamA} vs {m.teamB}</td>
                <td>{m.score}</td>
                <td>{new Date(m.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
