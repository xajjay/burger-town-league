---
import Base from '../layouts/Base.astro';
import { seasons, hallOfFame, isKnownPlayer } from '../data/leagueData.js';
---
<Base title="Hall of Fame | Burger Town Leagues">
  <section>
    <div class="wrap">
      <span class="eyebrow">Since Season 1</span>
      <h1 class="script-heading" style="margin-bottom: 8px;">Hall of Fame</h1>
      <p style="color: var(--paper-dim); max-width: 60ch; margin-bottom: 32px;">
        Eligibility: 3+ seasons played and at least one All-Star selection. Ranked by Legacy Score, a blend of accolades, career K/D, and longevity.
      </p>

      <h2 class="section-title">Legacy Rankings</h2>
      <p style="color: var(--paper-dim); font-size: 0.85rem; margin-bottom: 12px;">Click any column header to sort. Sorted by Legacy Score by default.</p>
      <div class="table-scroll" style="margin-bottom: 40px;">
        <table class="stat-table sortable-table">
          <thead>
            <tr>
              <th data-sort="text">Player</th>
              <th data-sort="num">Career K/D</th>
              <th data-sort="num">Seasons</th>
              <th data-sort="num">MVPs</th>
              <th data-sort="num">Titles</th>
              <th data-sort="num">All-Stars</th>
              <th data-sort="num" data-dir="desc" class="sorted-desc">Legacy Score</th>
            </tr>
          </thead>
          <tbody>
            {hallOfFame.map(p => (
              <tr>
                <td data-value={p.player}><a href={`/players/${encodeURIComponent(p.player)}`}>{p.player}</a></td>
                <td data-value={p.kd}>{p.kd.toFixed(2)}</td>
                <td data-value={p.numSeasons}>{p.numSeasons}</td>
                <td data-value={p.mvps}>{p.mvps}</td>
                <td data-value={p.championships}>{p.championships}</td>
                <td data-value={p.allStar1 + p.allStar2}>{p.allStar1}× 1st, {p.allStar2}× 2nd</td>
                <td data-value={p.legacyScore} style="color: var(--gold); font-weight: 700;">{p.legacyScore.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="section-title">Champions &amp; MVPs</h2>
      <div class="table-scroll">
        <table class="stat-table">
          <thead><tr><th>Season</th><th>Champion</th><th>MVP</th></tr></thead>
          <tbody>
            {seasons.map(s => (
              <tr>
                <td><a href={`/season/${s.id}`}>{s.name} ({s.year})</a></td>
                <td>{s.champion}</td>
                <td>{isKnownPlayer(s.mvp) ? <a href={`/players/${encodeURIComponent(s.mvp)}`}>{s.mvp}</a> : s.mvp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
