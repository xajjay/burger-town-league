---
import Base from '../../layouts/Base.astro';
---
<Base title="Games | Burger Town Leagues" description="Burger Town Leagues games built on real league data.">
  <section>
    <div class="wrap">
      <span class="eyebrow">Play</span>
      <h1 class="script-heading" style="margin-bottom: 8px;">Games</h1>
      <p style="color: var(--paper-dim); max-width: 60ch; margin-bottom: 32px;">
        Games built on real Burger Town history. New daily challenge every night at midnight Eastern.
      </p>
      <div class="grid grid-3">
        <a class="pixel-card" href="/games/12-0" style="text-decoration: none; display: block;">
          <span class="eyebrow">Daily challenge</span>
          <h2 class="script-heading" style="font-size: 2.4rem;">12&ndash;0</h2>
          <p style="color: var(--paper-dim); margin: 8px 0 16px;">
            Spin real teams from Seasons 1&ndash;5, draft 2 ARs and 2 SMGs, then run a double-elimination bracket against the best teams in league history. Can you go 12&ndash;0?
          </p>
          <span class="btn btn-primary">Play</span>
        </a>
      </div>
    </div>
  </section>
</Base>
