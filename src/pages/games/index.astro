---
import Base from '../../layouts/Base.astro';
const games = [
  { id: '12-0', href: '/games/12-0', title: '12–0', blurb: 'Spin real teams from Seasons 1–5, draft 2 ARs and 2 SMGs, then run a double-elimination bracket against the best teams in league history.' },
  { id: 'career-path', href: '/games/career-path', title: 'Career Path', blurb: 'Guess the player from the teams they played for. Wrong guesses unlock the seasons, then a K/D clue.' },
  { id: 'ranking-point', href: '/games/ranking-point', title: 'Ranking Point', blurb: 'Rank five players from one season by K/D, Respawn, SnD, interactions or Overall. Correct slots lock in green.' },
  { id: 'player-guessr', href: '/games/player-guessr', title: 'Player Guessr', blurb: 'Find the mystery player using seasons, rings, All-Stars, teammates and teams. Fewest guesses wins.' },
  { id: 'gridlock', href: '/games/gridlock', title: 'Gridlock', blurb: 'Fill a 3×3 grid with players who fit both the row and the column. Nine guesses, no repeats.' },
];
---
<Base title="Games | Burger Town Leagues" description="Daily challenges and free-play games built on real Burger Town Leagues history.">
  <section>
    <div class="wrap">
      <span class="eyebrow">Play</span>
      <h1 class="script-heading" style="margin-bottom: 8px;">Games</h1>
      <p style="color: var(--paper-dim); max-width: 60ch; margin-bottom: 8px;">
        Five games built on real Burger Town history. Each has a daily challenge that everyone gets the same, and a free play mode for extra rounds. New dailies drop at midnight Eastern.
      </p>
      <p id="hub-status" style="color: var(--paper-dim); font-size: 14px; margin-bottom: 24px;"></p>
      <div class="grid grid-3">
        {games.map(g => (
          <a class="pixel-card" href={g.href} data-game={g.id} style="text-decoration: none; display: block;">
            <span class="eyebrow" data-status>Daily challenge</span>
            <h2 class="script-heading" style="font-size: 2.4rem;">{g.title}</h2>
            <p style="color: var(--paper-dim); margin: 8px 0 16px;">{g.blurb}</p>
            <span class="btn btn-primary">Play</span>
          </a>
        ))}
      </div>
      <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
        <button class="btn btn-ghost" id="copyall" style="display:none">Copy today's results for Discord</button>
      </div>
    </div>
  </section>
</Base>
<script is:inline>
(function(){
  var order = ["12-0","career-path","ranking-point","player-guessr","gridlock"];
  var names = {"12-0":"12–0","career-path":"Career Path","ranking-point":"Ranking Point","player-guessr":"Player Guessr","gridlock":"Gridlock"};
  function etDate(){ return new Intl.DateTimeFormat("en-CA",{timeZone:"America/New_York",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()); }
  var d = etDate(), done = [], shares = [];
  order.forEach(function(g){
    var r = null; try { r = JSON.parse(localStorage.getItem("btlg-res-" + g + "-" + d) || "null"); } catch(e) {}
    var card = document.querySelector('[data-game="' + g + '"] [data-status]');
    if (r && card) { card.textContent = "Daily complete ✓"; card.style.color = "var(--gold)"; done.push(g); if (r.share) shares.push(r.share); }
  });
  var s = document.getElementById("hub-status");
  s.textContent = done.length ? "Today: " + done.length + " of 5 dailies done." : "Today: no dailies played yet.";
  var b = document.getElementById("copyall");
  if (shares.length) {
    b.style.display = "";
    b.onclick = function(){
      var t = "Burger Town Leagues dailies\n\n" + shares.join("\n\n");
      var ok = function(){ b.textContent = "Copied!"; setTimeout(function(){ b.textContent = "Copy today's results for Discord"; }, 1600); };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(ok, ok); else ok();
    };
  }
})();
</script>
