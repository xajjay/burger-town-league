---
import Base from '../../layouts/Base.astro';
import GameFrame from '../../components/GameFrame.astro';
import '../../styles/games.css';
import DATA from '../../data/game-12-0.json';
---
<Base title="Ranking Point | Burger Town Leagues" description="Rank five Burger Town Leagues players by a season stat. Daily challenge plus free play.">
<GameFrame title="Ranking Point" tagline="Five players from one season. Put them in order by the stat shown, highest on top, then lock it in. Correct slots turn green and lock; keep rearranging the rest.">
</GameFrame>
<script is:inline src="/scripts/btl-games-core.js"></script>
<script is:inline define:vars={{ DATA }}>
(function(){
const B = BTL, esc = B.esc, D = B.prep(DATA);
const MAXTRY = 5;
const STATS = {
  kd:{label:"Overall K/D", get:p=>p.kd, fmt:v=>v.toFixed(2)},
  rk:{label:"Respawn K/D", get:p=>p.rk, fmt:v=>v.toFixed(2)},
  sk:{label:"Search & Destroy K/D", get:p=>p.sk, fmt:v=>v.toFixed(2)},
  ip:{label:"Interactions per map", get:p=>p.ip, fmt:v=>v.toFixed(1)},
  o:{label:"Player Overall", get:p=>p.o, fmt:v=>String(v)}
};
const dispName = p => p.c;
const sub = p => (D.norm(p.n) !== D.norm(p.c) ? "aka " + p.n + " · " : "") + D.teams[p.t].name;

function makeRound(r){
  for (let tries = 0; tries < 200; tries++){
    const season = 1 + Math.floor(r() * 6);
    const key = season === 1 ? "kd" : season === 6 ? B.pick(["kd","rk","sk","ip"], r) : B.pick(Object.keys(STATS), r);
    const st = STATS[key];
    const cand = B.shuffle(DATA.players.filter(p => p.s === season && st.get(p) != null && (season !== 6 || p.m >= 12)), r);
    const chosen = [], seen = {};
    for (const p of cand){ const f = st.fmt(st.get(p)); if (seen[f]) continue; seen[f] = 1; chosen.push(p); if (chosen.length === 5) break; }
    if (chosen.length < 5) continue;
    const answer = chosen.slice().sort((a,b) => st.get(b) - st.get(a)).map(p => p.id);
    let order; do { order = B.shuffle(answer, r); } while (order.join() === answer.join());
    return {season, key, answer, order};
  }
}

B.shell({game:"ranking-point", start:function(ctx){
  const R = makeRound(ctx.rng), st = STATS[R.key], P = {};
  DATA.players.forEach(p => { if (R.answer.indexOf(p.id) >= 0) P[p.id] = p; });
  const S = ctx.saved && ctx.saved.order ? ctx.saved : {order:R.order.slice(), locked:[false,false,false,false,false], hist:[]};
  const allLocked = () => S.locked.every(Boolean);
  const over = () => allLocked() || S.hist.length >= MAXTRY;
  let dragging = null;

  const root = document.createElement("div"); root.className = "panel"; root.style.cssText = "display:flex;flex-direction:column;gap:12px";
  ctx.body.appendChild(root);

  function render(){
    const done = over(), reveal = done;
    let h = '<div class="rk-head"><div class="rk-stat"><small>Season ' + R.season + (R.season === 6 ? ' (in progress)' : '') + ' · rank by</small>' + esc(st.label) + '</div><div class="status">Attempt <b>' + Math.min(S.hist.length + 1, MAXTRY) + '</b> of ' + MAXTRY + '</div></div>';
    h += '<div class="rk-ends"><span>▲ Highest</span><span>' + (done ? "" : "drag the ≡ handle or use the arrows") + '</span></div><div class="rk-list" id="rklist">';
    S.order.forEach((id, i) => {
      const p = P[id], locked = S.locked[i], correct = R.answer.indexOf(id) === i;
      const showVal = locked || reveal;
      h += '<div class="rk-row' + (locked ? " locked" : "") + (reveal && !locked ? " miss" : "") + (String(dragging) === String(id) ? " dragging" : "") + '" data-i="' + i + '" data-id="' + id + '">' +
        '<span class="pos">' + (i+1) + '</span><div class="nm">' + esc(dispName(p)) + '<small>' + esc(sub(p)) + '</small></div>' +
        (showVal ? '<span class="val">' + st.fmt(st.get(p)) + '</span>' : '') +
        (!locked && !done ? '<div class="mv"><button data-mv="-1" aria-label="Move up">▲</button><button data-mv="1" aria-label="Move down">▼</button></div><button class="grip" aria-label="Drag to reorder">≡</button>' : (locked ? '<span aria-label="locked">🔒</span>' : '')) +
        '</div>';
    });
    h += '</div><div class="rk-ends"><span>▼ Lowest</span><span></span></div>';
    if (S.hist.length) h += '<div class="status">' + S.hist.map(r => r.map(x => x ? "🟩" : "⬛").join("")).join("  ") + '</div>';
    if (!done) h += '<div class="gm-actions"><button class="gbtn primary" id="lockin">Lock in order</button></div>';
    root.innerHTML = h;
  }

  function unlockedIdx(){ return S.locked.map((l,i) => l ? -1 : i).filter(i => i >= 0); }
  function moveTo(fromI, toI){ // both unlocked positions; move item, shift unlocked ones between
    const U = unlockedIdx(), a = U.indexOf(fromI), b = U.indexOf(toI);
    if (a < 0 || b < 0 || a === b) return false;
    const ids = U.map(i => S.order[i]); const [m] = ids.splice(a,1); ids.splice(b,0,m);
    U.forEach((pos,k) => { S.order[pos] = ids[k]; });
    return true;
  }
  root.addEventListener("click", e => {
    if (e.target.id === "lockin"){ submit(); return; }
    const mv = e.target.closest("[data-mv]");
    if (mv){
      const row = mv.closest(".rk-row"), i = +row.dataset.i, U = unlockedIdx(), k = U.indexOf(i), t = U[k + (+mv.dataset.mv)];
      if (t != null && moveTo(i, t)){ ctx.save(S); render(); const nr = root.querySelector('[data-id="' + row.dataset.id + '"] [data-mv="' + mv.dataset.mv + '"]'); if (nr) nr.focus(); }
    }
  });
  root.addEventListener("pointerdown", e => {
    const g = e.target.closest(".grip"); if (!g) return;
    e.preventDefault(); dragging = g.closest(".rk-row").dataset.id;
    const list = root.querySelector("#rklist"); list.setPointerCapture(e.pointerId);
    render(); const l2 = root.querySelector("#rklist"); l2.setPointerCapture(e.pointerId);
    const move = ev => {
      const el = document.elementFromPoint(ev.clientX, ev.clientY), row = el && el.closest(".rk-row");
      if (!row || row.dataset.id === dragging) return;
      const from = S.order.findIndex(x => String(x) === dragging), to = +row.dataset.i;
      if (moveTo(from, to)){ render(); root.querySelector("#rklist").setPointerCapture(e.pointerId); }
    };
    const up = () => { dragging = null; document.removeEventListener("pointermove", move); document.removeEventListener("pointerup", up); document.removeEventListener("pointercancel", up); ctx.save(S); render(); };
    document.addEventListener("pointermove", move); document.addEventListener("pointerup", up); document.addEventListener("pointercancel", up);
  });

  function submit(){
    const row = S.order.map((id,i) => R.answer[i] === id);
    S.hist.push(row);
    row.forEach((ok,i) => { if (ok) S.locked[i] = true; });
    ctx.save(S); render(); if (over()) finish();
  }
  function finish(){
    const win = allLocked(), n = S.hist.length;
    const grid = S.hist.map(r => r.map(x => x ? "🟩" : "⬛").join("")).join("\n");
    const cum = []; // show cumulative locks per attempt in share
    ctx.end({win:win, score:win ? n : null,
      headline: win ? "Ranked in " + n + " " + (n === 1 ? "attempt" : "attempts") + "!" : "Out of attempts",
      detail: "<b>Correct order</b> by " + esc(st.label) + ", Season " + R.season + ": " + R.answer.map(id => esc(P[id].c) + " (" + st.fmt(st.get(P[id])) + ")").join(" › "),
      share: (ctx.daily ? "Ranking Point #" + ctx.num : "Ranking Point (free play)") + " " + (win ? n : "X") + "/" + MAXTRY + "\n" + grid});
  }
  render(); if (over()) finish();
}});
})();
</script>
</Base>
