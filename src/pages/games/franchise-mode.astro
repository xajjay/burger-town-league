---
import Base from '../../layouts/Base.astro';
import GameFrame from '../../components/GameFrame.astro';
import '../../styles/games.css';
import DATA from '../../data/game-12-0.json';
---
<Base title="Franchise Mode | Burger Town Leagues" description="Run a Burger Town franchise: draft, set your lineup, trade, sim every match live, and chase the title.">
<GameFrame title="Franchise Mode" tagline="The deep version of Fantasy Draft. Draft a 5-player roster, manage your lineup, free agents and trades, and play every match of the season live." modes={false}>
  <div slot="rules" class="rules">
    <span><b>4 weeks, 2 matches a week.</b> Sim each of your matches live, then the week advances. Top 8 make a double-elimination playoff. Rosters lock once the playoffs start.</span>
    <span>Your progress saves in this browser. There is no daily challenge in this mode.</span>
  </div>
</GameFrame>
<script is:inline src="/scripts/btl-games-core.js"></script>
<script is:inline define:vars={{ DATA }}>
(function(){
const B = BTL, esc = B.esc, D = B.prep(DATA), NT = 12, ROUNDS = 5, SAVE = "btlg-franchise-v1";
const f2 = v => v.toFixed(2), f1 = v => v.toFixed(1), gm = B.norm;
const mean = a => a.reduce((x, y) => x + y, 0) / a.length, sd = a => { const m = mean(a); return Math.sqrt(mean(a.map(x => (x - m) * (x - m)))) || 1; };
function gauss(r){ let u = 0, v = 0; while (!u) u = r(); while (!v) v = r(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }

/* ---------- career cards ---------- */
const CARDS = {}, LIST = [];
D.list.forEach(e => {
  let wm = 0, wo = 0, wr = 0, ws = 0, wi = 0;
  e.rows.forEach(p => { const w = Math.max(1, p.m); wm += w; wo += p.o * w; wr += (p.rk != null ? p.rk : p.kd) * w; ws += (p.sk != null ? p.sk : p.kd) * w; wi += p.ip * w; });
  const last = e.rows[e.rows.length - 1];
  const c = {id:e.c, name:e.c, alias:e.aliasList, role:last.r, ovr:Math.min(99, wo / wm + Math.min(4, 1.2 * (e.seasons - 1))), kd:e.kd, rk:wr / wm, sk:ws / wm, ip:wi / wm, seasons:e.seasons, rings:e.champs, as:e.allstars, mvp:e.mvps};
  c.rating = c.ovr + 12 * ((c.rk + c.sk) / 2 - 1) + 0.15 * (c.ip - 37) + c.rings * 0.6 + c.as * 0.8 + c.mvp * 2;
  c.val = Math.pow(Math.max(1, c.rating - 55), 2.2) / 25;   // steep on purpose: one star outweighs several solid players
  CARDS[c.id] = c; LIST.push(c);
});
const stat = {o:[mean(LIST.map(c=>c.ovr)), sd(LIST.map(c=>c.ovr))], r:[mean(LIST.map(c=>c.rk)), sd(LIST.map(c=>c.rk))], s:[mean(LIST.map(c=>c.sk)), sd(LIST.map(c=>c.sk))], i:[mean(LIST.map(c=>c.ip)), sd(LIST.map(c=>c.ip))]};
LIST.forEach(c => { c.zo = (c.ovr - stat.o[0]) / stat.o[1]; c.zr = (c.rk - stat.r[0]) / stat.r[1]; c.zs = (c.sk - stat.s[0]) / stat.s[1]; c.zi = (c.ip - stat.i[0]) / stat.i[1]; });

/* ---------- franchise city names ---------- */
const MULTI = ["New Orleans","New York","Los Angeles","San Francisco","Oklahoma City","Mexico City","St. Petersburg"];
const FR = [], seenFr = {};
DATA.teams.forEach(t => {
  if (t.fa || /^(WCi|POBO)/.test(t.name) || seenFr[gm(t.name)]) return; seenFr[gm(t.name)] = 1;
  const m = MULTI.find(x => t.name.indexOf(x + " ") === 0), city = m || t.name.split(" ")[0];
  if (city.length > 1) FR.push({city});
});

/* ---------- roster helpers ---------- */
const cnt = (ids, role) => ids.filter(i => CARDS[i].role === role).length;
const validRoster = ids => cnt(ids, "AR") >= 2 && cnt(ids, "SMG") >= 2;
const canTake = (ids, c, total) => { // draft legality: keep 2 AR + 2 SMG reachable inside `total` picks
  const n = ids.length, ar = cnt(ids, "AR") + (c.role === "AR" ? 1 : 0), sm = cnt(ids, "SMG") + (c.role === "SMG" ? 1 : 0);
  return Math.max(0, 2 - ar) + Math.max(0, 2 - sm) <= total - (n + 1);
};
function bestLineup(ids){
  let best = null, bv = -1e9;
  ids.forEach(out => { const l = ids.filter(i => i !== out); if (cnt(l, "AR") < 2 || cnt(l, "SMG") < 2) return; const v = l.reduce((a, i) => a + CARDS[i].rating, 0); if (v > bv){ bv = v; best = l; } });
  return best || ids.slice(0, 4);
}
function aiValue(c, roster, g){
  const dR = roster.length ? mean(roster.map(x => CARDS[x].rk)) - mean(roster.map(x => CARDS[x].sk)) : 0;
  const wR = 0.5 + Math.max(-0.3, Math.min(0.3, -dR * 4)), kdTerm = wR * c.zr + (1 - wR) * c.zs;
  return 0.50 * c.zo + 0.28 * kdTerm + 0.14 * Math.min(c.zr, c.zs) + 0.08 * c.zi + g * 0.28;
}

/* ---------- save / load ---------- */
let G = null;
function load(){ try { const s = JSON.parse(localStorage.getItem(SAVE) || "null"); if (s && s.v === 1) return s; } catch(e){} return null; }
function save(){ try { localStorage.setItem(SAVE, JSON.stringify(G)); } catch(e){} }
const evr = () => B.rng(G.seed + "|e|" + (G.ev++));
const teamName = id => G.teams[id].name;
const userId = () => G.teams.findIndex(t => t.user);

/* ---------- league + draft ---------- */
function newGame(city){
  const seed = "fm|" + Date.now() + "|" + Math.random();
  const r = B.rng(seed + "|league"), key = gm(city);
  const pool = B.shuffle(FR.filter(f => gm(f.city) !== key), r), used = {}, ai = [];
  pool.forEach(f => { if (ai.length < 11 && !used[gm(f.city)]) { used[gm(f.city)] = 1; ai.push(f.city); } });
  const teams = ai.map((n, i) => ({id:i, name:n, user:false, roster:[], lineup:[]}));
  teams.push({id:11, name:city, user:true, roster:[], lineup:[]});
  const slot = B.shuffle(teams.map(t => t.id), r);
  G = {v:1, seed, ev:0, phase:"draft", tab:"schedule", teams, slot, picks:[], week:1, rIdx:0, sched:[], results:[], reg:{}, po:{}, form:{}, tb:[], faMoves:0, offers:[], tradeLog:[], txLog:[], poRes:{}, poIdx:0, seeds:[], awards:null, pending:null};
  save();
}
const owner = n => { const rd = Math.floor(n / NT), i = n % NT; return rd % 2 === 0 ? G.slot[i] : G.slot[NT - 1 - i]; };
function aiPick(t, n, taken, roster){
  const r = B.rng(G.seed + "|ai|" + n);
  let best = null, bv = -1e9;
  LIST.forEach(c => { if (taken[c.id] || !canTake(roster, c, ROUNDS)) return; const v = aiValue(c, roster, gauss(r)); if (v > bv){ bv = v; best = c; } });
  return best;
}
function replay(){
  const taken = {}, rosters = G.teams.map(() => []), log = []; let n = 0, up = 0;
  while (n < NT * ROUNDS){
    const t = owner(n); let c;
    if (G.teams[t].user){ if (up >= G.picks.length) break; c = CARDS[G.picks[up++]]; }
    else c = aiPick(t, n, taken, rosters[t]);
    taken[c.id] = 1; rosters[t].push(c.id); log.push({n, t, c}); n++;
  }
  return {n, taken, rosters, log};
}
function bestForUser(st){
  const ros = st.rosters[userId()]; let best = null, bv = -1e9;
  LIST.forEach(c => { if (st.taken[c.id] || !canTake(ros, c, ROUNDS)) return; const v = aiValue(c, ros.slice(), 0); if (v > bv){ bv = v; best = c; } });
  return best;
}

/* ---------- season setup ---------- */
function startSeason(st){
  G.teams.forEach((t, i) => { t.roster = st.rosters[i].slice(); t.lineup = bestLineup(t.roster); });
  const r = B.rng(G.seed + "|season");
  LIST.forEach(c => { G.form[c.id] = 1 + gauss(r) * 0.04; G.reg[c.id] = blank(); G.po[c.id] = blank(); });
  const idx = G.teams.map((_, i) => i), rounds = [];
  for (let k = 0; k < 11; k++){ const arr = [idx[0]].concat(idx.slice(1).slice(-k).concat(idx.slice(1).slice(0, 11 - k))); const pairs = []; for (let i = 0; i < 6; i++) pairs.push([arr[i], arr[11 - i]]); rounds.push(pairs); }
  G.sched = B.shuffle(rounds, r).slice(0, 8).map((pairs, i) => ({rd:i + 1, week:Math.floor(i / 2) + 1, pairs, done:false}));
  G.tb = G.teams.map(() => r());
  G.teams.forEach(t => { t.w = 0; t.l = 0; t.mw = 0; t.ml = 0; });
  G.phase = "season"; G.tab = "schedule"; G.week = 1; G.rIdx = 0; G.faMoves = 0;
  save();
}
function blank(){ return {k:{HP:0,SND:0,CTL:0}, d:{HP:0,SND:0,CTL:0}, m:0, ip:0}; }

/* ---------- match simulation ---------- */
const MODES = ["HP","SND","CTL","HP","SND"], MODE_NAME = {HP:"Hardpoint", SND:"Search & Destroy", CTL:"Control"}, MAPS = {HP:["Checkmate","Raid","Garrison","Apocalypse","Moscow"], SND:["Raid","Standoff","Express","Moscow","Miami"], CTL:["Raid","Checkmate","Garrison"]};
const BASE = {HP:24, SND:7, CTL:19}, ABSENT = 0.035;
const talent = (c, mode) => Math.min(1.4, 1 + 0.45 * ((mode === "SND" ? c.sk : c.rk) - 1));
function split(total, w){ const sum = w.reduce((a, b) => a + b, 0), raw = w.map(x => total * x / sum), out = raw.map(Math.floor); let rem = Math.round(total) - out.reduce((a, b) => a + b, 0); raw.map((r, i) => [r - out[i], i]).sort((a, b) => b[0] - a[0]).forEach(([, i]) => { if (rem > 0){ out[i]++; rem--; } }); return out; }
// who plays for a team in a match: starters, with the sub filling in for anyone who can't make it
function rollLineup(tid, r){
  const t = G.teams[tid], sub = t.roster.find(i => t.lineup.indexOf(i) < 0), ids = t.lineup.slice(), notes = []; let subUsed = false;
  if (sub) ids.forEach((id, k) => { if (!subUsed && r() < ABSENT){ ids[k] = sub; subUsed = true; notes.push({out:id, in:sub}); } });
  return {ids, notes};
}
function mkEnt(tid, lu){ return {tid, name:teamName(tid), user:G.teams[tid].user, ps:lu.ids.map(i => CARDS[i]), form:lu.ids.map(i => G.form[i]), notes:lu.notes}; }
function simSeries(A, Bt, bucket, r){
  const g = () => gauss(r), fa = g() * 1.2, fb = g() * 1.2; let wa = 0, wb = 0; const maps = []; const usedMaps = {};
  const modeAvg = (e, mode) => mean(e.ps.map(c => mode === "SND" ? c.sk : c.rk));
  while (wa < 3 && wb < 3){
    const mode = MODES[maps.length];
    const dd = mean(A.ps.map(c => c.ovr)) - mean(Bt.ps.map(c => c.ovr)) + fa - fb + 6 * (modeAvg(A, mode) - modeAvg(Bt, mode)) + 0.12 * (mean(A.ps.map(c => c.ip)) - mean(Bt.ps.map(c => c.ip)));
    const p = 1 / (1 + Math.exp(-dd / 6)), aWon = r() < p; aWon ? wa++ : wb++;
    // zero-sum kills/deaths
    const ra = A.ps.map((c, i) => talent(c, mode) * A.form[i]), rb = Bt.ps.map((c, i) => talent(c, mode) * Bt.form[i]);
    let R = mean(ra) / mean(rb) * (aWon ? 1.05 : 0.95) * (1 + g() * 0.03); R = Math.max(0.7, Math.min(1.45, R));
    const sq = Math.sqrt(R), n = 4 * BASE[mode], KA = n * sq, KB = n / sq, wk = x => x.map(v => v * (0.72 + r() * .56)), wd = x => x.map(v => (1 / v) * (0.72 + r() * .56));
    const ka = split(KA, wk(ra)), da = split(KB, wd(ra)), kb = split(KB, wk(rb)), db = split(KA, wd(rb));
    const lines = {A:[], B:[]};
    [[A, ka, da, "A"], [Bt, kb, db, "B"]].forEach(([e, k, d, side]) => e.ps.forEach((c, i) => {
      const ip = Math.max(8, Math.round(c.ip * e.form[i] * (0.9 + r() * 0.2))), dv = Math.max(1, d[i]), s = bucket[c.id];
      s.k[mode] += k[i]; s.d[mode] += dv; s.m++; s.ip += ip; lines[side].push([c.id, k[i], dv, ip]);
    }));
    const close = 1 - Math.abs(p - .5) * 2, hi = mode === "HP" ? 250 : mode === "SND" ? 6 : 3;
    const lo = mode === "HP" ? Math.round(120 + 125 * Math.min(1, close * .7 + r() * .45)) : mode === "SND" ? Math.min(5, Math.floor(r() * (2 + 4 * close))) : Math.min(2, Math.floor(r() * (1.2 + 2 * close)));
    const seq = []; if (mode !== "HP"){ const w = [], l = []; for (let i = 0; i < hi; i++) w.push("W"); for (let i = 0; i < lo; i++) w.push("L"); const arr = B.shuffle(w, r); arr.length = arr.length; let ww = 0; const out = []; arr.forEach(x => out.push(x)); 
      // last round always won by the winner
      const idxL = out.lastIndexOf("W"); if (idxL !== out.length - 1){ out.splice(idxL, 1); out.push("W"); } seq.push.apply(seq, out); }
    let mp; { const opts = MAPS[mode].filter(x => !usedMaps[mode + x]); mp = B.pick(opts.length ? opts : MAPS[mode], r); usedMaps[mode + mp] = 1; }
    maps.push({mode, map:mp, score:aWon ? [hi, lo] : [lo, hi], aWon, seq, lines});
  }
  return {a:A.tid, b:Bt.tid, wa, wb, maps, notesA:A.notes, notesB:Bt.notes};
}
// play one scheduled game (rating-based) and record it
function commitGame(rd, a, b, bucketName, r, detail, luA, luB){
  const bucket = G[bucketName], A = mkEnt(a, luA || rollLineup(a, r)), Bt = mkEnt(b, luB || rollLineup(b, r)), s = simSeries(A, Bt, bucket, r);
  if (bucketName === "reg"){ const ta = G.teams[a], tb = G.teams[b]; ta.mw += s.wa; ta.ml += s.wb; tb.mw += s.wb; tb.ml += s.wa; (s.wa > s.wb ? (ta.w++, tb.l++) : (tb.w++, ta.l++)); }
  G.results.push({rd, kind:bucketName, a, b, wa:s.wa, wb:s.wb, sub:s.notesA.concat(s.notesB), detail:detail ? s : null});
  return s;
}

/* ---------- season flow ---------- */
const LAYOUT = [
  {id:"W1", r:"Winners R1", a:["s",0], b:["s",7]}, {id:"W2", r:"Winners R1", a:["s",3], b:["s",4]}, {id:"W3", r:"Winners R1", a:["s",1], b:["s",6]}, {id:"W4", r:"Winners R1", a:["s",2], b:["s",5]},
  {id:"W5", r:"Winners semis", a:["w","W1"], b:["w","W2"]}, {id:"W6", r:"Winners semis", a:["w","W3"], b:["w","W4"]}, {id:"L1", r:"Losers R1", a:["l","W1"], b:["l","W2"]}, {id:"L2", r:"Losers R1", a:["l","W3"], b:["l","W4"]},
  {id:"L3", r:"Losers R2", a:["w","L1"], b:["l","W6"]}, {id:"L4", r:"Losers R2", a:["w","L2"], b:["l","W5"]}, {id:"W7", r:"Winners final", a:["w","W5"], b:["w","W6"]}, {id:"L5", r:"Losers R3", a:["w","L3"], b:["w","L4"]},
  {id:"L6", r:"Losers final", a:["w","L5"], b:["l","W7"]}, {id:"GF", r:"Grand final", a:["w","W7"], b:["w","L6"]}];
const winnerOf = res => res.wa > res.wb ? res.a : res.b, loserOf = res => res.wa > res.wb ? res.b : res.a;
const refTeam = ref => ref[0] === "s" ? G.seeds[ref[1]] : ref[0] === "w" ? winnerOf(G.poRes[ref[1]]) : loserOf(G.poRes[ref[1]]);
const standings = () => G.teams.slice().sort((a, b) => b.w - a.w || (b.mw - b.ml) - (a.mw - a.ml) || G.tb[b.id] - G.tb[a.id]);
const userPair = rd => G.sched[rd].pairs.find(p => p.indexOf(userId()) >= 0);
const eliminated = () => { const u = userId(); return LAYOUT.some(m => G.poRes[m.id] && (m.id[0] === "L" || m.id === "GF") && loserOf(G.poRes[m.id]) === u); };

function preparePending(){
  if (G.pending) return;
  if (G.phase === "season"){
    const pr = userPair(G.rIdx), r = evr();
    G.pending = {kind:"reg", rd:G.rIdx, a:pr[0], b:pr[1], luA:rollLineup(pr[0], r), luB:rollLineup(pr[1], r)};
  } else if (G.phase === "playoffs"){
    const m = LAYOUT[G.poIdx], a = refTeam(m.a), b = refTeam(m.b), r = evr();
    G.pending = {kind:"po", m:m.id, a, b, luA:rollLineup(a, r), luB:rollLineup(b, r)};
  }
  save();
}
function runPending(){
  const P = G.pending, r = B.rng(G.seed + "|m|" + (G.ev++));
  let s;
  if (P.kind === "reg"){
    s = commitGame(P.rd, P.a, P.b, "reg", r, true, P.luA, P.luB);
    const sr = G.sched[P.rd]; sr.pairs.forEach(pr => { if (pr[0] !== P.a || pr[1] !== P.b) commitGame(P.rd, pr[0], pr[1], "reg", evr(), false); });
    sr.done = true; G.rIdx++;
    if (G.rIdx % 2 === 0){ G.week++; G.faMoves = 0; if (G.rIdx < 8) makeOffers(); else G.offers = []; }
    if (G.rIdx >= 8){ G.awards = computeAwards(); G.phase = "awards"; G.offers = []; }
  } else {
    s = simSeries(mkEnt(P.a, P.luA), mkEnt(P.b, P.luB), G.po, r);
    G.poRes[P.m] = {a:P.a, b:P.b, wa:s.wa, wb:s.wb, detail:s}; G.poIdx++; checkDone();
  }
  const out = {P, s}; G.last = {P, s}; G.pending = null; save(); return out;
}
function autoPO(untilUser){
  while (G.poIdx < LAYOUT.length){
    const m = LAYOUT[G.poIdx], a = refTeam(m.a), b = refTeam(m.b), u = userId();
    if (untilUser && (a === u || b === u) && !eliminated()) break;
    const r = evr(), s = simSeries(mkEnt(a, rollLineup(a, r)), mkEnt(b, rollLineup(b, r)), G.po, r);
    G.poRes[m.id] = {a, b, wa:s.wa, wb:s.wb, detail:null}; G.poIdx++;
  }
  checkDone(); save();
}
function beginPlayoffs(){ G.seeds = standings().slice(0, 8).map(t => t.id); G.phase = "playoffs"; G.poIdx = 0; G.poRes = {}; G.tab = "schedule"; if (!G.seeds.includes(userId())) autoPO(false); else autoPO(true); save(); }
function checkDone(){
  if (G.poIdx >= LAYOUT.length && G.phase !== "done"){
    const gf = G.poRes.GF; G.champ = winnerOf(gf); G.runner = loserOf(gf);
    const pool = G.teams[G.champ].roster.map(i => ({c:CARDS[i], t:tot(G.po, i)})).filter(x => x.t.maps > 0).sort((a, b) => b.t.kd - a.t.kd);
    G.fmvp = pool.length ? pool[0].c.id : null; G.phase = "done";
  }
}

/* ---------- stats + awards ---------- */
function tot(bucket, id){ const s = bucket[id]; if (!s) return {K:0, D:0, kd:0, rkd:0, skd:0, ipm:0, maps:0}; const K = s.k.HP + s.k.SND + s.k.CTL, Dd = s.d.HP + s.d.SND + s.d.CTL, rK = s.k.HP + s.k.CTL, rD = s.d.HP + s.d.CTL;
  return {K, D:Dd, kd:K / Math.max(1, Dd), rkd:rK / Math.max(1, rD), skd:s.k.SND / Math.max(1, s.d.SND), ipm:s.ip / Math.max(1, s.m), maps:s.m}; }
const teamOfPlayer = id => G.teams.find(t => t.roster.indexOf(id) >= 0);
function combined(id){ const a = G.reg[id], b = G.po[id], o = blank(); ["HP","SND","CTL"].forEach(m => { o.k[m] = a.k[m] + b.k[m]; o.d[m] = a.d[m] + b.d[m]; }); o.m = a.m + b.m; o.ip = a.ip + b.ip; return o; }
function computeAwards(){
  const rows = LIST.map(c => ({c, t:tot(G.reg, c.id), tm:teamOfPlayer(c.id)})).filter(r => r.t.maps > 0);
  rows.forEach(r => { const wp = r.tm ? r.tm.w / 8 : 0.5; r.score = r.t.kd * 100 + 20 * (wp - .5); });
  rows.sort((a, b) => b.score - a.score);
  const used = {}, out = {mvp:rows[0].c.id, first:[], second:[]};
  ["first","second"].forEach(k => { const q = {AR:2, SMG:2}; rows.forEach(r => { if (used[r.c.id] || q[r.c.role] <= 0) return; used[r.c.id] = 1; q[r.c.role]--; out[k].push(r.c.id); }); });
  return out;
}

/* ---------- manager: free agents & trades ---------- */
function faPool(){ const on = {}; G.teams.forEach(t => t.roster.forEach(i => on[i] = 1)); return LIST.filter(c => !on[c.id]); }
function fixLineup(t){
  let l = t.lineup.filter(i => t.roster.indexOf(i) >= 0);
  t.roster.slice().sort((a, b) => CARDS[b].rating - CARDS[a].rating).forEach(i => { if (l.length < 4 && l.indexOf(i) < 0) l.push(i); });
  t.lineup = (cnt(l, "AR") >= 2 && cnt(l, "SMG") >= 2) ? l : bestLineup(t.roster);
}
function canManage(){ return G.phase === "season" || G.phase === "awards" ? G.phase === "season" : false; }
function signFA(faId, dropId){
  if (!canManage()) return "Rosters are locked.";
  if (G.faMoves >= 1) return "You already made your free agent move this week.";
  const t = G.teams[userId()], next = t.roster.filter(i => i !== dropId).concat(faId);
  if (!validRoster(next)) return "Your roster must keep at least 2 ARs and 2 SMGs.";
  t.roster = next; fixLineup(t); G.faMoves++; G.txLog.unshift("Week " + G.week + ": signed " + faId + ", released " + dropId); save(); return null;
}
const sumV = ids => ids.reduce((a, i) => a + CARDS[i].val, 0);
function evalTrade(tid, mine, theirs){
  const u = G.teams[userId()], t = G.teams[tid];
  if (!canManage()) return {ok:false, msg:"Rosters are locked."};
  if (!mine.length || mine.length !== theirs.length || mine.length > 3) return {ok:false, msg:"Trades must be 1-for-1, 2-for-2 or 3-for-3."};
  const myNext = u.roster.filter(i => mine.indexOf(i) < 0).concat(theirs), thNext = t.roster.filter(i => theirs.indexOf(i) < 0).concat(mine);
  const vin = sumV(mine), vout = sumV(theirs);
  if (!validRoster(myNext)) return {ok:false, msg:"That would leave you without 2 ARs and 2 SMGs.", vin, vout};
  if (!validRoster(thNext)) return {ok:false, msg:t.name + " can't give up that position mix.", vin, vout};
  if (vin < vout * 1.10) return {ok:false, msg:t.name + " declined: they need to come out ahead on value (at least ~10%).", vin, vout};
  return {ok:true, msg:t.name + " will accept this trade.", vin, vout};
}
function applyTrade(tid, mine, theirs){
  const u = G.teams[userId()], t = G.teams[tid];
  u.roster = u.roster.filter(i => mine.indexOf(i) < 0).concat(theirs); t.roster = t.roster.filter(i => theirs.indexOf(i) < 0).concat(mine);
  fixLineup(u); t.lineup = bestLineup(t.roster);
  G.tradeLog.unshift("Week " + G.week + ": sent " + mine.join(", ") + " to " + t.name + " for " + theirs.join(", ")); save();
}
function makeOffers(){
  G.offers = []; const r = evr(); if (r() > 0.8) return;
  const u = G.teams[userId()];
  for (let tries = 0; tries < 400 && G.offers.length < 2; tries++){
    const tid = Math.floor(r() * 11), t = G.teams[tid], n = r() < 0.7 ? 1 : 2;
    const mine = B.shuffle(u.roster, r).slice(0, n), theirs = B.shuffle(t.roster, r).slice(0, n);
    const myNext = u.roster.filter(i => mine.indexOf(i) < 0).concat(theirs), thNext = t.roster.filter(i => theirs.indexOf(i) < 0).concat(mine);
    if (!validRoster(myNext) || !validRoster(thNext)) continue;
    const vin = sumV(mine), vout = sumV(theirs);
    if (vin < vout * 1.10 || vout < vin * 0.72) continue;
    if (G.offers.some(o => o.tid === tid)) continue;
    G.offers.push({id:G.ev + "-" + tries, tid, mine, theirs});
  }
}

