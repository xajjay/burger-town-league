  const t = G.teams[userId()];
  if (mt === "lineup"){
    h += panel("Lineup · 4 starters and 1 substitute", '<div class="status" style="margin-bottom:8px">Starters need at least 2 ARs and 2 SMGs. The sub plays only when a starter has a scheduling conflict (rare).</div><div class="rgrid r5">' +
      t.roster.map(i => { const c = CARDS[i], st = t.lineup.indexOf(i) >= 0, x = tot(G.reg, i); return '<div class="rslot ' + (st ? "" : "subslot") + '"><span class="label">' + (st ? "Starter" : "Substitute") + '</span>' + roleTag(c.role) + '<b>' + esc(c.name) + '</b><span class="num">OVR ' + f1(c.ovr) + '</span><span class="sm">' + (x.maps ? f2(x.kd) + ' K/D · ' + x.maps + ' maps' : 'no maps yet') + '</span>' + (locked ? "" : (st ? btn("bench", "Bench", "ghost sm", i) : btn("bench", "Not needed", "ghost sm", i, true))) + '</div>'; }).join("") + '</div>' +
      (view.msg ? '<div class="glnote err" style="margin-top:8px">' + esc(view.msg) + '</div>' : '') + '<div class="status" style="margin-top:8px">To start your sub, bench a starter. Benching swaps the sub into the lineup.</div>');
  } else if (mt === "fa"){
    const f = view.faRole, q = gm(view.faQ);
    let pool = faPool().filter(c => (f === "ALL" || c.role === f) && (!q || D.byC[c.id].search.indexOf(q) >= 0));
    const key = {ovr:c => -c.ovr, kd:c => -c.kd, rk:c => -c.rk, sk:c => -c.sk, ip:c => -c.ip}[view.faSort]; pool.sort((a, b) => key(a) - key(b));
    const opt = (v, cur, l) => '<option value="' + v + '"' + (v === cur ? " selected" : "") + '>' + l + '</option>';
    h += panel("Free agents · " + faPool().length + " available · one add/drop per week (" + (G.faMoves ? "used" : "available") + ")",
      (view.faPick ? '<div class="notice">Sign <b>' + esc(view.faPick) + '</b> — who do you release?<div class="gm-actions" style="margin-top:8px">' + t.roster.map(i => btn("signfa", "Release " + esc(nm(i)), "ghost sm", i)).join("") + btn("faCancel", "Cancel", "ghost sm") + '</div></div>' : "") +
      (view.msg ? '<div class="glnote err">' + esc(view.msg) + '</div>' : "") +
      '<div class="filters"><div class="gm-modes">' + ["ALL","AR","SMG"].map(r => '<button class="chip" data-act="farole" data-arg="' + r + '" aria-pressed="' + (f === r) + '">' + r + '</button>').join("") + '</div><select data-sel="fasort">' + opt("ovr", view.faSort, "Sort: Overall") + opt("kd", view.faSort, "Sort: K/D") + opt("rk", view.faSort, "Sort: Respawn K/D") + opt("sk", view.faSort, "Sort: SnD K/D") + opt("ip", view.faSort, "Sort: Interactions") + '</select><input class="pk-in" data-sel="faq" style="flex:1 1 160px;width:auto;padding:8px 10px" placeholder="Search" value="' + esc(view.faQ) + '"></div>' +
      tbl(["Player","Pos","OVR","K/D","Resp","SnD","Int",""], pool.slice(0, 60).map(c => '<tr><td><b>' + esc(c.name) + '</b></td><td>' + roleTag(c.role) + '</td><td class="num"><b>' + f1(c.ovr) + '</b></td><td class="num">' + f2(c.kd) + '</td><td class="num">' + f2(c.rk) + '</td><td class="num">' + f2(c.sk) + '</td><td class="num">' + f1(c.ip) + '</td><td>' + (locked ? "" : btn("fapick", "Sign", G.faMoves ? "ghost sm" : "primary sm", c.id, !!G.faMoves)) + '</td></tr>')));
    if (G.txLog.length) h += panel("Your transactions", '<ul class="logl">' + G.txLog.map(x => '<li>' + esc(x) + '</li>').join("") + '</ul>');
  } else {
    const tid = view.tradeTid, ot = G.teams[tid];
    h += panel("Trade offers from other teams", G.offers.length && !locked ? '<div class="logl">' + G.offers.map(o => '<div class="offer"><div><b>' + esc(teamName(o.tid)) + '</b> offers ' + o.theirs.map(i => pl(i) + ' <small>(' + f1(CARDS[i].ovr) + ')</small>').join(" + ") + ' for your ' + o.mine.map(i => pl(i) + ' <small>(' + f1(CARDS[i].ovr) + ')</small>').join(" + ") + '</div><div class="gm-actions">' + btn("accept", "Accept", "primary sm", o.id) + btn("decline", "Decline", "ghost sm", o.id) + '</div></div>').join("") + '</div>' : '<div class="status">No offers right now. Offers can arrive at the start of each week.</div>');
    const others = G.teams.filter(x => !x.user);
    const pick = (ids, sel, side) => '<div class="tradecol"><div class="alab">' + (side === "m" ? "You send" : esc(ot.name) + " sends") + '</div>' + ids.map(i => '<label class="tchk"><input type="checkbox" data-trade="' + side + '" value="' + esc(i) + '"' + (sel.indexOf(i) >= 0 ? " checked" : "") + (locked ? " disabled" : "") + '> ' + roleTag(CARDS[i].role) + ' <b>' + esc(nm(i)) + '</b> <small>OVR ' + f1(CARDS[i].ovr) + ' · ' + f2(CARDS[i].kd) + ' K/D · value ' + f1(CARDS[i].val) + '</small></label>').join("") + '</div>';
    const ev = view.tradeMine.length || view.tradeTheirs.length ? evalTrade(tid, view.tradeMine, view.tradeTheirs) : null;
    h += panel("Propose a trade · 1-for-1, 2-for-2 or 3-for-3 only", '<div class="filters"><select data-sel="ttid">' + others.map(x => '<option value="' + x.id + '"' + (x.id === tid ? " selected" : "") + '>' + esc(x.name) + '</option>').join("") + '</select></div><div class="twocol">' + pick(t.roster, view.tradeMine, "m") + pick(ot.roster, view.tradeTheirs, "t") + '</div>' +
      (ev ? '<div class="glnote ' + (ev.ok ? "ok" : "err") + '" style="margin-top:8px">' + esc(ev.msg) + (ev.vin != null ? ' <span class="num">(you send value ' + f1(ev.vin) + ' · you receive ' + f1(ev.vout) + ')</span>' : '') + '</div>' : '<div class="status" style="margin-top:8px">Pick players on both sides. Value is steep: one star is worth much more than several solid players, and the other team must come out ahead.</div>') +
      '<div class="gm-actions" style="margin-top:8px">' + btn("propose", "Propose trade", "primary", null, locked || !ev || !ev.ok) + '</div>');
    if (G.tradeLog.length) h += panel("Trade history", '<ul class="logl">' + G.tradeLog.map(x => '<li>' + esc(x) + '</li>').join("") + '</ul>');
  }
  return h;
}

/* ---------- match screen ---------- */
function lineupHTML(tid, lu){ const subs = lu.notes.map(n => n.in);
  return '<div class="mcol"><div class="alab">' + esc(teamName(tid)) + (G.teams[tid].user ? " ★" : "") + '</div><ul class="logl">' + lu.ids.map(i => '<li>' + roleTag(CARDS[i].role) + ' <b>' + esc(nm(i)) + '</b> <small>OVR ' + f1(CARDS[i].ovr) + (subs.indexOf(i) >= 0 ? ' · SUB' : '') + '</small></li>').join("") + '</ul>' + lu.notes.map(n => '<div class="notice">⚠ ' + esc(nm(n.out)) + ' has a scheduling conflict — ' + esc(nm(n.in)) + ' subs in.</div>').join("") + '</div>';
}
function renderMatch(){
  if (view.mstage === "preview"){
    const P = G.pending; if (!P){ view.screen = null; return render(); }
    const title = P.kind === "reg" ? "Week " + G.week + " · Match " + (G.rIdx % 2 + 1) : LAYOUT.find(m => m.id === P.m).r + " · " + P.m;
    root.innerHTML = panel(title, '<div style="font-size:26px;font-weight:800;text-align:center">' + esc(teamName(P.a)) + ' <span style="color:var(--muted)">vs</span> ' + esc(teamName(P.b)) + '</div><div class="status" style="text-align:center">Best of 5: Hardpoint, Search & Destroy, Control, Hardpoint, Search & Destroy</div>') +
      panel("Tonight's lineups", '<div class="twocol">' + lineupHTML(P.a, P.luA) + lineupHTML(P.b, P.luB) + '</div>') + '<div class="gm-actions">' + btn("startmatch", "Start the match", "primary") + btn("back", "Back", "ghost") + '</div>';
  } else if (view.mstage === "play"){
    root.innerHTML = '<div class="panel" id="live"></div><div class="gm-actions" id="liveact">' + btn("skip", "Skip to final", "ghost") + '</div><div id="boxarea"></div>';
    animate(view.out);
  } else renderBoxScreen();
}
function renderBoxScreen(){
  const s = view.out.s;
  root.innerHTML = panel("Final", boxBanner(s)) + '<div id="boxarea">' + boxHTML(s) + '</div><div class="gm-actions">' + btn("donematch", "Continue", "primary") + '</div>';
}
function boxBanner(s){ const win = s.wa > s.wb ? s.a : s.b; return '<div style="text-align:center"><div style="font-size:28px;font-weight:800">' + esc(teamName(s.a)) + ' <span class="num" style="color:var(--mustard)">' + s.wa + ' – ' + s.wb + '</span> ' + esc(teamName(s.b)) + '</div><div class="status">' + esc(teamName(win)) + ' win the series</div></div>'; }
function boxHTML(s){
  const mi = view.boxTab == null ? -1 : view.boxTab;
  const tabs = '<div class="gm-modes" style="margin:10px 0">' + btn("boxtab", "Series", mi < 0 ? "primary sm" : "ghost sm", -1) + s.maps.map((m, i) => btn("boxtab", "Map " + (i + 1) + " · " + m.mode, mi === i ? "primary sm" : "ghost sm", i)).join("") + '</div>';
  const side = (key, tid, notes) => {
    const subs = notes.map(n => n.in), acc = {};
    s.maps.forEach((m, i) => { if (mi >= 0 && i !== mi) return; m.lines[key].forEach(([id, k, d, ip]) => { const a = acc[id] || (acc[id] = {k:0, d:0, ip:0, n:0}); a.k += k; a.d += d; a.ip += ip; a.n++; }); });
    return '<div class="mcol"><div class="alab">' + esc(teamName(tid)) + '</div>' + tbl(["Player","K","D","K/D","Int"], Object.keys(acc).map(id => { const a = acc[id]; return '<tr><td><b>' + esc(nm(id)) + '</b>' + (subs.indexOf(id) >= 0 ? ' <small>(sub)</small>' : '') + '</td><td class="num">' + a.k + '</td><td class="num">' + a.d + '</td><td class="num"><b>' + f2(a.k / Math.max(1, a.d)) + '</b></td><td class="num">' + f1(a.ip / a.n) + '</td></tr>'; })) + '</div>';
  };
  const mp = mi >= 0 ? '<div class="status">' + MODE_NAME[s.maps[mi].mode] + ' · ' + s.maps[mi].map + ' · ' + s.maps[mi].score[0] + '–' + s.maps[mi].score[1] + '</div>' : '<div class="status">' + s.maps.map(m => m.mode + " " + m.map + " " + m.score[0] + "–" + m.score[1]).join(" · ") + '</div>';
  return '<div class="panel"><div class="label">Box score</div>' + tabs + mp + '<div class="twocol">' + side("A", s.a, s.notesA) + side("B", s.b, s.notesB) + '</div></div>';
}
async function animate(out){
  const s = out.s, token = view.anim = (view.anim || 0) + 1; view.skip = false; view.boxTab = null;
  const live = () => root.querySelector("#live"); if (!live()) return;
  const d = ms => view.skip ? Promise.resolve() : sleep(ms), alive = () => view.anim === token && view.screen === "match" && live();
  let tw = [0, 0]; const log = [];
  const draw = (mapI, sa, sb, note) => { if (!alive()) return; const m = s.maps[mapI];
    live().innerHTML = '<div class="live"><div class="lteam">' + esc(teamName(s.a)) + '<span class="mapw num">' + tw[0] + '</span></div><div class="lscore num">' + sa + ' <span>–</span> ' + sb + '</div><div class="lteam r">' + esc(teamName(s.b)) + '<span class="mapw num">' + tw[1] + '</span></div></div><div class="lmap">Map ' + (mapI + 1) + ' · ' + MODE_NAME[m.mode] + ' · ' + esc(m.map) + '</div><div class="status" style="text-align:center;min-height:1.4em">' + (note || "") + '</div><ul class="logl llog">' + log.map(x => '<li>' + x + '</li>').join("") + '</ul>'; };
  for (let i = 0; i < s.maps.length; i++){
    const m = s.maps[i], [fa, fb] = m.score, wi = m.aWon ? 0 : 1; let a = 0, b = 0;
    draw(i, 0, 0, "Map starting…"); await d(900); if (!alive()) return;
    if (m.mode === "HP"){ const steps = 24; for (let t = 1; t <= steps; t++){ const f = t / steps; a = t === steps ? fa : Math.floor(fa * f); b = t === steps ? fb : Math.floor(fb * f); draw(i, a, b, "Holding the hill…"); await d(85); if (!alive()) return; } }
    else { for (const x of m.seq){ const winnerScores = x === "W"; ((winnerScores ? wi : 1 - wi) === 0) ? a++ : b++; draw(i, a, b, "Round " + (a + b) + ": " + esc(teamName(((winnerScores ? wi : 1 - wi) === 0) ? s.a : s.b)) + " win"); await d(560); if (!alive()) return; } }
    tw[wi]++; log.push('Map ' + (i + 1) + ' (' + MODE_NAME[m.mode] + ', ' + esc(m.map) + '): <b>' + esc(teamName(wi === 0 ? s.a : s.b)) + '</b> win ' + fa + '–' + fb); draw(i, fa, fb, "Map to " + esc(teamName(wi === 0 ? s.a : s.b)) + " · series " + tw[0] + "–" + tw[1]); await d(1200); if (!alive()) return;
  }
  if (!alive()) return;
  view.mstage = "box"; renderBoxScreen();
}

/* ---------- actions ---------- */
function shareRecap(){
  const u = userId(), me = G.teams[u], place = G.champ === u ? "🏆 Champions" : G.runner === u ? "Runner-up" : G.seeds.indexOf(u) >= 0 ? "Made the playoffs" : "Missed playoffs";
  return "BTL Franchise Mode\n" + me.name + " · " + me.w + "–" + me.l + " · " + place + "\nChampions: " + teamName(G.champ) + (G.fmvp ? " · Finals MVP " + nm(G.fmvp) : "") + "\n" + B.SITE + "/games/franchise-mode";
}
function act(a, arg, el){
  switch (a){
    case "new": { const v = (root.querySelector("#city") || {}).value; if (!v || !v.trim()) return; newGame(v.trim().replace(/[<>]/g, "")); break; }
    case "pick": G.picks.push(arg); save(); window.scrollTo({top:0, behavior:"smooth"}); break;
    case "auto": G.picks.push(bestForUser(replay()).id); save(); window.scrollTo({top:0, behavior:"smooth"}); break;
    case "role": view.filt.role = arg; break;
    case "startseason": startSeason(replay()); break;
    case "tab": G.tab = arg; view.msg = ""; save(); break;
    case "mtab": view.mtab = arg; view.msg = ""; break;
    case "preview": preparePending(); view.screen = "match"; view.mstage = "preview"; break;
    case "back": G.pending = null; save(); view.screen = null; break;
    case "startmatch": view.out = runPending(); view.screen = "match"; view.mstage = "play"; break;
    case "skip": view.skip = true; return;
    case "donematch": view.screen = null; view.boxTab = null; break;
    case "lastbox": view.out = G.last; view.screen = "match"; view.mstage = "box"; view.boxTab = null; break;
    case "boxtab": view.boxTab = +arg; break;
    case "playoffs": beginPlayoffs(); break;
    case "simpo": autoPO(!(eliminated() || G.seeds.indexOf(userId()) < 0)); break;
    case "openteam": G.tab = "rosters"; view.open[arg] = true; save(); render(); { const e = root.querySelector("#tr-" + arg); if (e) e.scrollIntoView({behavior:"smooth", block:"center"}); } return;
    case "bench": { const t = G.teams[userId()], next = t.roster.filter(i => i !== arg); if (cnt(next, "AR") < 2 || cnt(next, "SMG") < 2){ view.msg = "Your starting four needs at least 2 ARs and 2 SMGs."; break; } t.lineup = next; view.msg = ""; save(); break; }
    case "farole": view.faRole = arg; break;
    case "fapick": view.faPick = arg; view.msg = ""; break;
    case "faCancel": view.faPick = null; break;
    case "signfa": { const err = signFA(view.faPick, arg); view.msg = err || ""; if (!err) view.faPick = null; break; }
    case "propose": { const ev = evalTrade(view.tradeTid, view.tradeMine, view.tradeTheirs); if (ev.ok){ applyTrade(view.tradeTid, view.tradeMine, view.tradeTheirs); view.tradeMine = []; view.tradeTheirs = []; } break; }
    case "accept": { const o = G.offers.find(x => x.id === arg); if (o){ const t = G.teams[o.tid], u = G.teams[userId()]; if (o.mine.every(i => u.roster.indexOf(i) >= 0) && o.theirs.every(i => t.roster.indexOf(i) >= 0) && validRoster(u.roster.filter(i => o.mine.indexOf(i) < 0).concat(o.theirs))){ applyTrade(o.tid, o.mine, o.theirs); G.offers = G.offers.filter(x => x.id !== arg); } else { G.offers = G.offers.filter(x => x.id !== arg); } save(); } break; }
    case "decline": G.offers = G.offers.filter(x => x.id !== arg); save(); break;
    case "reset": view.confirmReset = true; break;
    case "noreset": view.confirmReset = false; break;
    case "reset2": try { localStorage.removeItem(SAVE); } catch(e){} G = null; view = Object.assign(view, {screen:null, confirmReset:false}); break;
    case "sharerecap": B.copy(shareRecap(), el); return;
  }
  render();
}
root.addEventListener("click", e => { const b = e.target.closest("[data-act]"); if (!b || b.disabled) return; e.preventDefault(); act(b.dataset.act, b.dataset.arg, b); });
root.addEventListener("change", e => {
  const s = e.target.closest("[data-sel]"), tc = e.target.closest("[data-trade]"); if (tc){ const arr = tc.dataset.trade === "m" ? view.tradeMine : view.tradeTheirs, v = tc.value, i = arr.indexOf(v); if (tc.checked && i < 0) arr.push(v); if (!tc.checked && i >= 0) arr.splice(i, 1); render(); return; }
  if (!s) return; const k = s.dataset.sel, v = s.value;
  if (k === "scope" || k === "team" || k === "sort") view.stats[k] = v; else if (k === "fasort") view.faSort = v; else if (k === "ttid"){ view.tradeTid = +v; view.tradeMine = []; view.tradeTheirs = []; }
  render();
});
root.addEventListener("input", e => { const s = e.target.closest('[data-sel="faq"]'); if (s){ view.faQ = s.value; const pos = s.selectionStart; render(); const n = root.querySelector('[data-sel="faq"]'); if (n){ n.focus(); n.setSelectionRange(pos, pos); } } });
G = load();
window.__fm = {get G(){ return G; }, CARDS, LIST, evalTrade, sumV};
render();
})();

</script>
