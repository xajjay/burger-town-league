---
import Base from '../../layouts/Base.astro';
import GameFrame from '../../components/GameFrame.astro';
import '../../styles/games.css';
import DATA from '../../data/game-12-0.json';
---
<Base title="Career Path | Burger Town Leagues" description="Guess the Burger Town Leagues player from the teams they played for. Daily challenge plus free play.">
<GameFrame title="Career Path" tagline="Guess the player from the teams they played for, in order. Three guesses: a wrong answer unlocks the seasons, then a K/D clue, then the answer.">
</GameFrame>
<script is:inline src="/scripts/btl-games-core.js"></script>
<script is:inline define:vars={{ DATA }}>
(function(){
const B = BTL, esc = B.esc, D = B.prep(DATA);
const POOL = D.list.filter(e => e.seasons >= 3);
const ITEMS = D.list.map(e => ({id:e.c, label:e.c, sub:e.aliasList.length ? "aka "+e.aliasList.join(", ") : "", search:e.search}));
const MAX = 3;

B.shell({game:"career-path", start:function(ctx){
  const target = B.pick(POOL, ctx.rng);
  const S = ctx.saved && ctx.saved.g ? ctx.saved : {g:[]};
  const won = () => S.g.length && S.g[S.g.length-1] === target.c;
  const over = () => won() || S.g.length >= MAX;
  const wrong = () => S.g.filter(x => x !== target.c).length;

  const root = document.createElement("div"); root.className = "panel"; root.style.display = "flex"; root.style.flexDirection = "column"; root.style.gap = "14px";
  ctx.body.appendChild(root);
  const entryHost = document.createElement("div"); entryHost.className = "gm-entry";
  let pk = null;

  function render(){
    const w = wrong(), done = over();
    const showSeasons = w >= 1 || done, showKD = w >= 2 || done;
    let h = '<div class="label">Mystery player · ' + (done ? "solved" : "guess " + (Math.min(S.g.length+1, MAX)) + " of " + MAX) + '</div>';
    h += '<div class="path">' + target.rows.map(p => '<div class="stop"><span class="tn">' + esc(D.teams[p.t].name) + '</span><span class="ts">' + (showSeasons ? "Season " + p.s : "Season ?") + '</span></div>').join("") + '</div>';
    h += '<div class="clue' + (showKD ? "" : " locked") + '"><span class="label">Clue 2 · Career K/D</span><div class="num" style="font-size:20px;font-weight:800">' + (showKD ? target.kd.toFixed(2) + ' <span class="status">over ' + target.rows.reduce((a,p)=>a+p.m,0) + ' maps</span>' : "Unlocks after 2 wrong guesses") + '</div></div>';
    h += '<div class="status">' + (showSeasons ? "Seasons revealed. " : "Wrong guess #1 reveals the seasons. ") + '</div>';
    h += '<div class="hearts" aria-label="guesses">' + Array.from({length:MAX}, (_,i) => '<span class="pip ' + (i < S.g.length ? (S.g[i] === target.c ? "hit" : "miss") : "") + '"></span>').join("") + '</div>';
    if (S.g.some(x => x !== target.c)) h += '<div class="wrongs">' + S.g.filter(x => x !== target.c).map(x => '<span>' + esc(x) + '</span>').join("") + '</div>';
    root.innerHTML = h;
    if (!done) { root.appendChild(entryHost); }
  }

  function finish(){
    const win = won(), used = S.g.length;
    const squares = S.g.map(x => x === target.c ? "🟩" : "🟥").join("") + "⬛".repeat(Math.max(0, MAX - used));
    const t = ctx.daily ? "Career Path #" + ctx.num : "Career Path (free play)";
    ctx.end({win:win, score:win ? used : null,
      headline: win ? "Got it in " + used + " " + (used === 1 ? "guess" : "guesses") + "!" : "Out of guesses",
      detail: '<div class="reveal" style="color:var(--text)">' + esc(target.c) + '</div>' + (target.aliasList.length ? '<div>aka ' + esc(target.aliasList.join(", ")) + '</div>' : '') +
        '<div>' + target.seasons + ' seasons · ' + target.champs + ' ring' + (target.champs === 1 ? "" : "s") + ' · ' + target.allstars + ' All-Star' + (target.allstars === 1 ? "" : "s") + ' · career K/D ' + target.kd.toFixed(2) + '</div>',
      share: t + " " + (win ? used : "X") + "/" + MAX + "\n" + squares});
  }

  pk = B.picker(entryHost, ITEMS, {placeholder:"Who is it? Type a player name…", exclude:() => Object.fromEntries(S.g.map(x => [x,1])), onPick:function(it){
    S.g.push(it.id); ctx.save(S); update();
  }});
  function update(){ render(); if (over()) finish(); else if (window.innerWidth > 720) pk.focus(); }
  render();
  if (over()) finish();
}});
})();
</script>
</Base>
