---
import Base from '../../layouts/Base.astro';
import GameFrame from '../../components/GameFrame.astro';
import '../../styles/games.css';
import DATA from '../../data/game-12-0.json';
---
<Base title="Player Guessr | Burger Town Leagues" description="Guess the mystery Burger Town Leagues player using seasons played, rings, All-Stars, teammates and teams. Daily challenge plus free play.">
<GameFrame title="Player Guessr" tagline="Guess the mystery player in as few tries as you can. Every guess shows what it has in common with them, and the mystery card fills in as you go.">
  <div slot="rules" class="rules">
    <span><b>Seasons</b> played · <b>Rings</b> = championships · <b>All-Stars</b> · <b>Teammates</b> = shared a roster with the mystery player · <b>Teams</b> played for.</span>
    <span>Includes all six seasons, through the Season 6 (BTL Season 1) awards.</span>
    <span>Green = exact match. Yellow = off by one. Arrows point toward the mystery player's number.</span>
  </div>
</GameFrame>
<script is:inline src="/scripts/btl-games-core.js"></script>
<script is:inline define:vars={{ DATA }}>
(function(){
const B = BTL, esc = B.esc, D = B.prep(DATA), MAX = 10;
const POOL = D.list.filter(e => e.seasons >= 2 || e.champs || e.allstars || e.mvps);
const ITEMS = D.list.map(e => ({id:e.c, label:e.c, sub:e.aliasList.length ? "aka " + e.aliasList.join(", ") : "", search:e.search}));
const FIELDS = [["seasons","Seasons"],["champs","Rings"],["allstars","All-Stars"]];

B.shell({game:"player-guessr", start:function(ctx){
  const T = B.pick(POOL, ctx.rng);
  const S = ctx.saved && ctx.saved.g ? ctx.saved : {g:[]};
  const won = () => S.g.length && S.g[S.g.length-1] === T.c;
  const over = () => won() || S.g.length >= MAX;

  const root = document.createElement("div"); root.style.cssText = "display:flex;flex-direction:column;gap:14px"; ctx.body.appendChild(root);
  const card = document.createElement("div"); card.className = "panel"; card.style.cssText = "display:flex;flex-direction:column;gap:10px";
  const entryHost = document.createElement("div"); entryHost.className = "gm-entry";
  const tbl = document.createElement("div"); tbl.className = "gtable";
  root.appendChild(card); root.appendChild(entryHost); root.appendChild(tbl);

  function know(){
    const k = {}; FIELDS.forEach(([f]) => k[f] = {lo:0, hi:Infinity, exact:false});
    const mates = [], teams = [];
    S.g.forEach(c => {
      const G = D.byC[c];
      FIELDS.forEach(([f]) => { const g = G[f], t = T[f], q = k[f]; if (g === t) q.exact = true; else if (g < t) q.lo = Math.max(q.lo, g + 1); else q.hi = Math.min(q.hi, g - 1); });
      if (c !== T.c && G.tm[T.c]) mates.push(c);
      G.teamNames.forEach(n => { if (T.teamKeys[D.norm(n)] && !teams.some(x => D.norm(x) === D.norm(n))) teams.push(n); });
    });
    return {k, mates, teams};
  }
  function renderCard(){
    const K = know(), done = over(), nonm = S.g.filter(c => c !== T.c && !D.byC[c].tm[T.c]).length;
    let h = '<div class="label">Mystery player' + (done ? "" : " · guess " + (S.g.length + 1) + " of " + MAX) + '</div>';
    h += '<div class="reveal" style="' + (done ? "" : "color:var(--line)") + '">' + (done ? esc(T.c) : "? ? ? ? ?") + '</div><div class="mystery">';
    FIELDS.forEach(([f, lab]) => {
      const q = K.k[f], got = q.exact || done; let v, cls = "v";
      if (got) v = T[f]; else if (q.lo > 0 && q.hi < Infinity) { v = q.lo + "–" + q.hi; cls += " lo"; } else if (q.lo > 0) { v = q.lo + "+"; cls += " lo"; } else if (q.hi < Infinity) { v = "≤" + q.hi; cls += " lo"; } else { v = "?"; cls += " q"; }
      h += '<div class="mcell' + (q.exact ? " got" : "") + '"><div class="label">' + lab + '</div><div class="' + cls + '">' + v + '</div></div>';
    });
    h += '<div class="mcell' + (K.mates.length ? " got" : "") + '"><div class="label">Teammates</div><div class="sm">' + (done ? "Roster mates: " + (Object.keys(T.tm).map(esc).join(", ") || "none") : (K.mates.length ? "Played with " + K.mates.map(esc).join(", ") : "None yet")) + (!done && nonm ? '<br>Not teammates: ' + nonm : "") + '</div></div>';
    h += '<div class="mcell' + (K.teams.length ? " got" : "") + '"><div class="label">Teams</div><div class="sm">' + (done ? T.teamNames.map(esc).join(" → ") : (K.teams.length ? K.teams.map(esc).join(", ") : "None found yet")) + '</div></div>';
    h += '</div>';
    card.innerHTML = h;
  }
  function numCell(f, G){
    const g = G[f], t = T[f], d = g - t;
    const cls = d === 0 ? "eq" : Math.abs(d) === 1 ? "near" : "";
    return '<div class="gcell ' + cls + '"><span class="big">' + g + '</span>' + (d === 0 ? "" : '<span class="ar">' + (d < 0 ? "↑ higher" : "↓ lower") + '</span>') + '</div>';
  }
  function renderTable(){
    let h = '<div class="grow head"><div class="gcell hd">Player</div><div class="gcell hd">Seasons</div><div class="gcell hd">Rings</div><div class="gcell hd">All-Stars</div><div class="gcell hd">Teammate</div><div class="gcell hd" style="align-items:flex-start">Teams</div></div>';
    S.g.slice().reverse().forEach(c => {
      const G = D.byC[c], mate = c !== T.c && G.tm[T.c], me = c === T.c;
      h += '<div class="grow"><div class="gcell nm' + (me ? " eq" : "") + '">' + esc(c) + (G.aliasList.length ? '<span class="ar" style="font-weight:400">aka ' + esc(G.aliasList[0]) + '</span>' : '') + '</div>' +
        numCell("seasons", G) + numCell("champs", G) + numCell("allstars", G) +
        '<div class="gcell ' + (me ? "eq" : mate ? "eq" : "") + '"><span class="big">' + (me ? "★" : mate ? "✓" : "✗") + '</span></div>' +
        '<div class="gcell teams">' + G.teamNames.map(n => '<span class="tag2' + (T.teamKeys[D.norm(n)] ? " hit" : "") + '">' + esc(n) + '</span>').join("") + '</div></div>';
    });
    tbl.innerHTML = h;
  }
  function finish(){
    const win = won(), n = S.g.length;
    const marks = S.g.map((c,i) => { if (c === T.c) return "🟩"; const G = D.byC[c]; let m = 0; ["seasons","champs","allstars"].forEach(f => { if (G[f] === T[f]) m++; }); if (G.tm[T.c]) m++; return m >= 2 ? "🟨" : "⬛"; }).join("");
    ctx.end({win:win, score:win ? n : null,
      headline: win ? "Found them in " + n + " " + (n === 1 ? "guess" : "guesses") + "!" : "Out of guesses",
      detail: '<div class="reveal" style="color:var(--text)">' + esc(T.c) + '</div>' + (T.aliasList.length ? '<div>aka ' + esc(T.aliasList.join(", ")) + '</div>' : '') + '<div>' + T.teamNames.map(esc).join(" → ") + '</div>',
      share: (ctx.daily ? "Player Guessr #" + ctx.num : "Player Guessr (free play)") + " " + (win ? n : "X") + "/" + MAX + "\n" + marks});
  }
  const pk = B.picker(entryHost, ITEMS, {placeholder:"Guess a player…", exclude:() => Object.fromEntries(S.g.map(x => [x,1])), onPick:function(it){
    S.g.push(it.id); ctx.save(S); update();
  }});
  function update(){ renderCard(); renderTable(); if (over()){ entryHost.hidden = true; finish(); } else if (window.innerWidth > 720) pk.focus(); }
  update();
}});
})();
</script>
</Base>
