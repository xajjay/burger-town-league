---
const { eyebrow = 'Games', title, tagline } = Astro.props;
---
<div class="gm">
  <div class="wrap gm-wrap">
    <header class="gm-top">
      <div class="gm-brand">
        <a class="eyebrow" href="/games" style="text-decoration:none">{eyebrow}</a>
        <h1 class="script-heading">{title}</h1>
        <p class="gm-tag">{tagline}</p>
      </div>
      <div class="gm-side">
        <div class="gm-modes" role="group" aria-label="Game mode">
          <button class="chip" id="m-daily" aria-pressed="true">Daily challenge</button>
          <button class="chip" id="m-free" aria-pressed="false">Free play</button>
        </div>
        <div class="gm-info" id="gm-info"></div>
      </div>
    </header>
    <slot name="rules" />
    <div id="gm-body" class="gm-body"></div>
  </div>
</div>
